---
import SiteHeader from '../components/SiteHeader.astro';
import SiteDrawer from '../components/SiteDrawer.astro';
import JoinBanner from '../components/JoinBanner.astro';
import SiteFooter from '../components/SiteFooter.astro';
import type { Locale } from '../lib/locale';

interface Props {
  /** which locale route this page was generated for */
  locale: Locale;
  /** <title>, English. Arabic pages render titleAr instead. */
  title: string;
  /** <html data-title-ar> — read by assets/js/i18n.js and the admin preview */
  titleAr: string;
  description?: string;
  /** drawer nav key that gets is-current */
  current?: string;
  /** index and 404 are the only pages that link the 512px icon */
  appleTouchIcon?: boolean;
  /** the shared "Join the Alliance" band before the footer */
  joinBanner?: boolean;
}

const {
  locale,
  title,
  titleAr,
  description = '',
  current,
  appleTouchIcon = false,
  joinBanner = true,
} = Astro.props;
---
<html data-title-ar={titleAr} dir={locale === 'ar' ? 'rtl' : 'ltr'} lang={locale}>
<head>
<meta charset="utf-8"/>
<base href="/"/>
<meta content="width=device-width, initial-scale=1" name="viewport"/>
<title>{locale === 'ar' ? titleAr : title}</title>
<meta content={description} name="description"/>
<meta content="#015C44" name="theme-color"/>
<meta content="noindex, nofollow" name="robots"/>
<link href="assets/img/logo-mark.png" rel="icon" type="image/png"/>
{appleTouchIcon && <link href="assets/img/favicon-512.png" rel="apple-touch-icon"/>}
<link href="https://fonts.googleapis.com" rel="preconnect"/>
<link crossorigin="" href="https://fonts.gstatic.com" rel="preconnect"/>
<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Arabic:wght@400;500;600;700&amp;family=Inter:wght@300;400;500;600;700&amp;family=Space+Grotesk:wght@500;600;700&amp;display=swap" rel="stylesheet"/>
<slot name="head" />
<link href="assets/css/style.css?v=28" rel="stylesheet"/>
<script is:inline>document.documentElement.classList.add('js');</script>
</head>
<body>
<!-- =============== SCROLL PROGRESS =============== -->
<div id="scroll-progress"></div>
<!-- =============== HEADER =============== -->
<SiteHeader locale={locale} />
<SiteDrawer current={current} locale={locale} />
<slot />
{joinBanner && <JoinBanner locale={locale} />}
<SiteFooter locale={locale} />
<script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js"></script>
<script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/ScrollTrigger.min.js"></script>
<script is:inline src="https://cdn.jsdelivr.net/npm/lenis@1.1.14/dist/lenis.min.js"></script>
<slot name="scripts" />
<script is:inline src="assets/js/i18n.js?v=28"></script>
<slot name="scripts-late" />
<script is:inline src="assets/js/main.js?v=28"></script>
</body>
</html>
