---
interface Props { locale: 'en' | 'ar' }
const { locale } = Astro.props;
---
<footer class="site-foot">
<div class="wrap">
<div class="foot-cols">
<div class="foot-col">
<h4 data-ar="روابط سريعة">Quick links</h4>
<ul>
<li><a data-ar="عن التحالف" href={`/${locale}/about`}>About SAFTA</a></li>
<li><a data-ar="مجموعات العمل" href={`/${locale}/technologies`}>Working Groups</a></li>
<li><a data-ar="المتحالفون" href={`/${locale}/members`}>Members</a></li>
<li><a data-ar="الأخبار والفعاليات" href={`/${locale}/media`}>News &amp; Events</a></li>
<li><a data-ar="سجّل اهتمامك" href={`/${locale}/register-interest`}>Register interest</a></li>
</ul>
</div>
<div class="foot-col">
<h4 data-ar="الشؤون النظامية">Legal</h4>
<ul>
<li><a data-ar="الشروط والأحكام" href={`/${locale}/terms`}>Terms &amp; Conditions</a></li>
<li><a data-ar="سياسة الخصوصية" href={`/${locale}/privacy`}>Privacy Policy</a></li>
<li><a data-ar="إشعار ملفات الارتباط" href={`/${locale}/cookies`}>Cookie Notice</a></li>
<li><a data-ar="إمكانية الوصول" href={`/${locale}/accessibility`}>Accessibility</a></li>
<li><a data-ar="خريطة الموقع" href={`/${locale}/sitemap`}>Sitemap</a></li>
</ul>
</div>
<div class="foot-col">
<h4 data-ar="تواصل معنا">Connect</h4>
<ul>
<li><a href="mailto:secretariat@safta.sa">secretariat@safta.sa</a></li>
<li><a data-ar="تواصل معنا" href={`/${locale}/contact`}>Contact us</a></li>
<li><a href="https://www.linkedin.com/company/saudi-agrifood-tech-alliance-safta/" rel="noopener" target="_blank">LinkedIn</a></li>
<li><a href="https://x.com/SAFTA_KSA" rel="noopener" target="_blank">X (Twitter)</a></li>
</ul>
</div>
<div class="socials">
<a aria-label="X" href="https://x.com/SAFTA_KSA" rel="noopener" target="_blank"><svg fill="currentColor" height="16" viewBox="0 0 24 24" width="16"><path d="M18.9 2H22l-7 8 8.2 12h-6.4l-5-7.3L5.9 22H2.8l7.5-8.6L2.4 2h6.6l4.5 6.6L18.9 2zm-1.1 18h1.7L7.3 3.8H5.5L17.8 20z"></path></svg></a>
<a aria-label="LinkedIn" href="https://www.linkedin.com/company/saudi-agrifood-tech-alliance-safta/" rel="noopener" target="_blank"><svg fill="currentColor" height="16" viewBox="0 0 24 24" width="16"><path d="M4.98 3.5A2.5 2.5 0 1 0 5 8.5a2.5 2.5 0 0 0-.02-5zM3 9h4v12H3zM9 9h3.8v1.7h.05c.53-.95 1.83-1.95 3.77-1.95C20.4 8.75 21 11 21 14v7h-4v-6.2c0-1.5-.03-3.4-2.1-3.4-2.1 0-2.4 1.6-2.4 3.3V21H9z"></path></svg></a>
<a aria-label="Email" href="mailto:secretariat@safta.sa"><svg fill="none" height="16" stroke="currentColor" stroke-width="1.7" viewBox="0 0 24 24" width="16"><rect height="15" rx="2.5" width="19" x="2.5" y="4.5"></rect><path d="M3 6.5l9 6.5 9-6.5"></path></svg></a>
</div>
</div>
<div class="foot-bottom">
<small data-ar="© 2026 التحالف السعودي لتقنيات الزراعة والغذاء (SAFTA).">© 2026 SAFTA — Saudi AgriFood Tech Alliance.</small>
<button aria-label="Back to top" class="to-top" id="toTop"><svg fill="none" height="15" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" width="15"><path d="M12 19V5M6 11l6-6 6 6"></path></svg></button>
<a aria-label="SAFTA — التحالف السعودي لتقنيات الزراعة والغذاء" class="brand" href={`/${locale}`}><img alt="SAFTA — Saudi AgriFood Tech Alliance" src="assets/img/logo-safta-dark.png"/></a>
</div>
</div>
</footer>
