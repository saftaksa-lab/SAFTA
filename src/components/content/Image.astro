---
/**
 * An image slot: the uploaded media when `media` resolves, otherwise `fallback`
 * (the slot's default art from src/lib/safta-assets.ts). The prop is not `id`,
 * so the element's own `id` attribute can pass through with the rest.
 *
 * Alt text is single-language, because i18n.js never swaps `alt`. Pass `alt`
 * to decide it here (`""` for a decorative slide background); leave it out to
 * use the media row's own alt text.
 */
import { resolveImage } from '../../lib/safta-assets';

interface Props {
  /** A media id, or `null` for the fallback. */
  media: string | null;
  fallback: string;
  alt?: string;
  [attr: string]: unknown;
}

const { media, fallback, alt, ...rest } = Astro.props;
const image = resolveImage(media, fallback);
---
<img src={image.src} width={image.width} height={image.height} alt={alt ?? image.alt} {...rest} />
