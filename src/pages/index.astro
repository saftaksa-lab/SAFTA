<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8"/>
<meta content="width=device-width, initial-scale=1" name="viewport"/>
<meta content="noindex, nofollow" name="robots"/>
<title>SAFTA</title>
<meta http-equiv="refresh" content="0;url=/en"/>
<script is:inline>
(function () {
  try {
    var saved = localStorage.getItem('safta.lang');
    var lang = (saved === 'ar' || saved === 'en')
      ? saved
      : ((navigator.language || '').toLowerCase().indexOf('ar') === 0 ? 'ar' : 'en');
    location.replace('/' + lang + location.search + location.hash);
  } catch (e) {
    location.replace('/en');
  }
})();
</script>
</head>
<body>
<p>Continue in <a href="/en">English</a> / المتابعة <a href="/ar">بالعربية</a></p>
</body>
</html>
