---
import AdminLayout from '../../layouts/AdminLayout.astro';

// Access is enforced in src/middleware.ts; a user is guaranteed here.
const user = Astro.locals.user!;

const roleLabels: Record<string, string> = {
  admin: 'مدير',
  user: 'عضو',
};

const pages = [
  { label: 'الصفحة الرئيسية', href: '/admin/home', text: 'الواجهة والتحديات والجوائز والشركاء' },
  { label: 'عن التحالف', href: '/admin/about', text: 'الرسالة والأرقام والأدوار والبيان التأسيسي' },
  { label: 'مجموعات العمل', href: '/admin/technologies', text: 'صفحة مجموعات العمل وبطاقاتها' },
  { label: 'التقارير', href: '/admin/reports', text: 'صفحة التقارير وروابطها' },
  { label: 'الأخبار والفعاليات', href: '/admin/media', text: 'الأخبار والفعاليات وصفحة الخبر' },
  { label: 'الأعضاء', href: '/admin/members', text: 'دليل الأعضاء وخريطتهم وصفحة العضو' },
  { label: 'تواصل معنا', href: '/admin/contact', text: 'صفحة التواصل ونموذجها' },
  { label: 'سجّل اهتمامك', href: '/admin/register-interest', text: 'صفحة التسجيل ونموذجها' },
];
---

<AdminLayout title="نظرة عامة" lede="إدارة محتوى موقع التحالف السعودي لتقنيات الزراعة والغذاء.">
  <div class="panel">
    <h2 class="panel__title">الحساب</h2>
    <dl class="panel__facts">
      <dt class="panel__term">الاسم</dt>
      <dd class="panel__detail">{user.name}</dd>

      <dt class="panel__term">البريد الإلكتروني</dt>
      <dd class="panel__detail panel__detail--ltr">{user.email}</dd>

      <dt class="panel__term">الصلاحية</dt>
      <dd class="panel__detail">{roleLabels[user.role ?? ''] ?? user.role}</dd>
    </dl>
  </div>

  <div class="panel">
    <h2 class="panel__title">المحتوى</h2>
    <dl class="panel__facts">
      {
        pages.map((page) => (
          <>
            <dt class="panel__term">{page.label}</dt>
            <dd class="panel__detail">
              <a href={page.href}>{page.text}</a>
            </dd>
          </>
        ))
      }
    </dl>
  </div>
</AdminLayout>
