---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout
  title="Login | SAFTA"
  titleAr="تسجيل الدخول | التحالف السعودي"
>
<main>
<section class="page-hero page-hero--plain">
<div class="wrap">
<p class="crumbs"><a data-ar="الرئيسية" href="/">Home</a><span>/</span>Login</p>
<h1 data-ar="دخول الأعضاء">Members login</h1>
</div>
</section>
<section class="ribbon">
<div class="wrap">
<div class="login-shell reveal">
<p class="eyebrow" data-ar="منطقة الأعضاء" style="text-align:center">Members area</p>
<h2 class="h-section" data-ar="تسجيل الدخول" style="text-align:center;margin-top:12px">Sign in</h2>
<p class="lede" data-ar="دخول أعضاء التحالف إلى مركز تحكّم المحتوى." style="text-align:center;margin-top:14px">Alliance members sign in to the content control centre.</p>
<form class="form" id="loginForm" novalidate="" style="margin-top:38px">
<div class="field"><label data-ar="اسم المستخدم" for="l-user">Username</label><input autocapitalize="off" autocomplete="username" dir="ltr" id="l-user" required="" spellcheck="false" type="text"/></div>
<div class="field"><label data-ar="كلمة المرور" for="l-pass">Password</label><input autocomplete="current-password" dir="ltr" id="l-pass" required="" type="password"/></div>
<label class="check"><input type="checkbox"/><span data-ar="أبقني مسجّلاً على هذا الجهاز">Keep me signed in on this device</span></label>
<div class="form-actions" style="flex-direction:column;align-items:stretch">
<button class="btn-solid" style="justify-content:center" type="submit"><span data-ar="تسجيل الدخول">Sign in</span><svg fill="none" height="16" stroke="currentColor" stroke-width="1.6" viewBox="0 0 24 24" width="16"><path d="M5 12h13M13 6l6 6-6 6"></path></svg></button>
<span class="form-msg" hidden="" id="lMsg" style="justify-content:center"></span>
</div>
</form>
<p class="login-note">Not a member yet? <a data-ar="سجّل اهتمامك" href="/register-interest" style="color:var(--c-link)">Register your interest</a>  ·  <a data-ar="نسيت كلمة المرور" href="/forgot-password" style="color:var(--c-link)">Forgot password</a></p>
</div>
</div>
</section>
</main>
<script slot="scripts-late" is:inline src="assets/js/members-auth.js?v=28"></script>
</BaseLayout>
