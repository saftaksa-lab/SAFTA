---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Text from '../../components/content/Text.astro';
import { getSingleton } from '../../lib/content/cache';
import { english, pick } from '../../lib/bilingual';
import { crumbHome } from '../../lib/ui';
import { isLocale } from '../../lib/locale';

export function getStaticPaths() {
  return [{ params: { locale: 'en' } }, { params: { locale: 'ar' } }];
}
const { locale } = Astro.params;
if (!isLocale(locale)) return new Response(null, { status: 404 });

const hero = getSingleton('contact_hero');
const form = getSingleton('contact_form');
const info = getSingleton('contact_info');
// Placeholders swap through data-ar-placeholder, which i18n.js assigns as plain text.
const placeholder = (name: 'namePlaceholder' | 'emailPlaceholder' | 'phonePlaceholder' | 'companyPlaceholder') => {
  const field = pick(form, name);
  return { placeholder: english(field), 'data-ar-placeholder': field.ar };
};
---
<BaseLayout
  locale={locale}
  title="Contact us | SAFTA"
  titleAr="تواصل معنا | التحالف السعودي"
  description="For inquiries, partnership opportunities or support requests, please contact us."
  current="contact"
>
<main>
<section class="page-hero page-hero--plain">
<div class="wrap">
<p class="crumbs"><Text as="a" field={crumbHome} href={`/${locale}`} /><span>/</span>Contact</p>
<Text as="h1" field={pick(hero, 'title')} />
<Text as="p" field={pick(hero, 'lede')} class="lede" />
</div>
</section>
<section class="ribbon" id="contactMain">
<div class="wrap">
<div class="form-shell contact-page">
<form class="form reveal" id="contactForm" novalidate="">

<div class="field">
<Text as="label" field={pick(form, 'nameLabel')} for="c-name" required />
<input autocomplete="name" id="c-name" {...placeholder('namePlaceholder')} name="fullName" required=""/>
</div>

<div class="row-2">
<div class="field">
<Text as="label" field={pick(form, 'emailLabel')} for="c-email" required />
<input autocomplete="email" id="c-email" {...placeholder('emailPlaceholder')} name="email" required="" type="email"/>
</div>
<div class="field">
<Text as="label" field={pick(form, 'phoneLabel')} for="c-phone" />
<Text as="p" field={pick(form, 'phoneHint')} class="hint hint--top" />
<input autocomplete="tel" id="c-phone" inputmode="tel" name="mobile" {...placeholder('phonePlaceholder')} type="tel" value="+966"/>
</div>
</div>

<div class="row-2">
<div class="field">
<Text as="label" field={pick(form, 'companyLabel')} for="c-company" required />
<input autocomplete="organization" id="c-company" {...placeholder('companyPlaceholder')} name="company" required=""/>
</div>
<div class="field">
<Text as="label" field={pick(form, 'sectorLabel')} for="c-sector" required />
<select id="c-sector" name="sector" required="">
<Text as="option" field={pick(form, 'sectorPrompt')} value="" />
{form.sectorOptions.map((option) => (
<Text as="option" field={pick(option, 'label')} value={option.value} />
))}
</select>
</div>
</div>

<div class="field">
<Text as="label" field={pick(form, 'countryLabel')} for="c-country" />
<select id="c-country" name="country">
<Text as="option" field={pick(form, 'countryPrompt')} value="" />
{form.countryOptions.map((option) => (
<Text as="option" field={pick(option, 'label')} value={option.value} />
))}
</select>
</div>

<div class="form-actions">
<button class="btn-solid" type="submit"><Text as="span" field={pick(form, 'submitLabel')} /><svg fill="none" height="16" stroke="currentColor" stroke-width="1.6" viewBox="0 0 24 24" width="16"><path d="M5 12h13M13 6l6 6-6 6"></path></svg></button>
<span class="form-msg" id="cMsg"><svg fill="none" height="18" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" width="18"><path d="M20 6L9 17l-5-5"></path></svg><Text as="span" field={pick(form, 'successMessage')} /></span>
</div>

</form>
<aside class="aside-card reveal">
<Text as="h3" field={pick(info, 'heading')} />
<Text as="p" field={pick(info, 'lede')} class="aside-card__lede" />

<ul class="aside-list">
<li>
<span class="aside-list__ico"><svg fill="none" height="16" stroke="currentColor" stroke-width="1.7" viewBox="0 0 24 24" width="16"><rect height="15" rx="2.5" width="19" x="2.5" y="4.5"></rect><path d="M3 6.5l9 6.5 9-6.5"></path></svg></span>
<span><Text as="b" field={pick(info, 'generalLabel')} /><a href={`mailto:${info.email}`}>{info.email}</a></span>
</li>
<li>
<span class="aside-list__ico"><svg fill="none" height="16" stroke="currentColor" stroke-width="1.7" viewBox="0 0 24 24" width="16"><path d="M12 5v14M5 12h14"></path></svg></span>
<span><Text as="b" field={pick(info, 'membershipLabel')} /><Text as="a" field={pick(info, 'membershipLinkLabel')} href={`/${locale}/register-interest`} /></span>
</li>
<li>
<span class="aside-list__ico"><svg fill="none" height="16" stroke="currentColor" stroke-width="1.7" viewBox="0 0 24 24" width="16"><path d="M4 5h16v14H4z"></path><path d="M8 9h8M8 13h5"></path></svg></span>
<span><Text as="b" field={pick(info, 'mediaLabel')} /><Text as="a" field={pick(info, 'mediaLinkLabel')} href={`/${locale}/media`} /></span>
</li>
<li>
<span class="aside-list__ico"><svg fill="none" height="16" stroke="currentColor" stroke-width="1.7" viewBox="0 0 24 24" width="16"><circle cx="12" cy="12" r="9"></circle><path d="M12 7v5l3 2"></path></svg></span>
<span><Text as="b" field={pick(info, 'responseLabel')} /><Text as="span" field={pick(info, 'responseText')} class="aside-list__txt" /></span>
</li>
</ul>

<div class="aside-card__social">
<Text as="p" field={pick(info, 'followLabel')} />
<div>
<a aria-label="LinkedIn" href="https://www.linkedin.com/company/saudi-agrifood-tech-alliance-safta/" rel="noopener" target="_blank"><svg fill="currentColor" height="15" viewBox="0 0 24 24" width="15"><path d="M4.98 3.5A2.5 2.5 0 1 0 5 8.5a2.5 2.5 0 0 0-.02-5zM3 9h4v12H3zM9 9h3.8v1.7h.05c.53-.95 1.83-1.95 3.77-1.95C20.4 8.75 21 11 21 14v7h-4v-6.2c0-1.5-.03-3.4-2.1-3.4-2.1 0-2.4 1.6-2.4 3.3V21H9z"></path></svg></a>
<a aria-label="X" href="https://x.com/SAFTA_KSA" rel="noopener" target="_blank"><svg fill="currentColor" height="15" viewBox="0 0 24 24" width="15"><path d="M18.9 2H22l-7 8 8.2 12h-6.4l-5-7.3L5.9 22H2.8l7.5-8.6L2.4 2h6.6l4.5 6.6L18.9 2z"></path></svg></a>
</div>
</div>
</aside>
</div>
</div>
</section>
</main>
</BaseLayout>
