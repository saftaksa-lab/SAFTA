---
import BaseLayout from '../../layouts/BaseLayout.astro';

export function getStaticPaths() {
  return [{ params: { locale: 'en' } }, { params: { locale: 'ar' } }];
}
const { locale } = Astro.params;
---
<BaseLayout
  locale={locale}
  title="Contact us | SAFTA"
  titleAr="تواصل معنا | التحالف السعودي"
  description="For inquiries, partnership opportunities or support requests, please contact us."
  current="contact"
>
<main>
<section class="page-hero page-hero--plain">
<div class="wrap">
<p class="crumbs"><a data-cms="t001-الرئيسية" data-ar="الرئيسية" href={`/${locale}`}>Home</a><span>/</span>Contact</p>
<h1 data-cms="t002-تواصل-معنا" data-ar="تواصل معنا">Contact us</h1>
<p data-cms="t003-للاستفسارات-وفرص-الشراكة-و" class="lede" data-ar="للاستفسارات وفرص الشراكة وطلبات الدعم، تواصل معنا.">For inquiries, partnership opportunities or support requests, please contact us.</p>
</div>
</section>
<section class="ribbon" id="contactMain">
<div class="wrap">
<div class="form-shell contact-page">
<form class="form reveal" id="contactForm" novalidate="">

<div class="field">
<label data-cms="t004-الاسم-الكامل" data-ar="الاسم الكامل" for="c-name">Full Name <b class="req">*</b></label>
<input data-cms-ph="p005-مثال-سارة-الأحمد" autocomplete="name" id="c-name" data-ar-placeholder="مثال: سارة الأحمد" placeholder="e.g. Sara Al-Ahmed" name="fullName" required=""/>
</div>

<div class="row-2">
<div class="field">
<label data-cms="t006-البريد-الإلكتروني" data-ar="البريد الإلكتروني" for="c-email">Email <b class="req">*</b></label>
<input data-cms-ph="p007-namecompanycom" autocomplete="email" id="c-email" data-ar-placeholder="name@company.com" placeholder="name@company.com" name="email" required="" type="email"/>
</div>
<div class="field">
<label data-cms="t008-رقم-الجوال" data-ar="رقم الجوال" for="c-phone">Phone number</label>
<p data-cms="t009-أضف-رمز-الدولة-مثال-96659x" class="hint hint--top" data-ar="أضف رمز الدولة. مثال: ‎+96659xxxxxxx">Kindly add the country code. Exp: +96659xxxxxxx</p>
<input data-cms-ph="p010-966" autocomplete="tel" data-ar-placeholder="‎+966" id="c-phone" inputmode="tel" name="mobile" placeholder="+966" type="tel" value="+966"/>
</div>
</div>

<div class="row-2">
<div class="field">
<label data-cms="t011-اسم-الجهة-أو-الشركة" data-ar="اسم الجهة أو الشركة" for="c-company">Company name <b class="req">*</b></label>
<input data-cms-ph="p012-مثال-الكثبان-الخضراء" autocomplete="organization" id="c-company" data-ar-placeholder="مثال: الكثبان الخضراء" placeholder="e.g. Green Dunes" name="company" required=""/>
</div>
<div class="field">
<label data-cms="t013-القطاع" data-ar="القطاع" for="c-sector">Sector <b class="req">*</b></label>
<select id="c-sector" name="sector" required="">
<option data-cms="t014-الرجاء-الاختيار" data-ar="الرجاء الاختيار" value="">Please Select</option>
<option data-cms="t015-تقنيات-الزراعة" data-ar="تقنيات الزراعة" value="Agriculture technology">Agriculture technology</option>
<option data-cms="t016-تقنيات-الأغذية" data-ar="تقنيات الأغذية" value="Food technology">Food technology</option>
<option data-cms="t017-المياه-والري" data-ar="المياه والري" value="Water & irrigation">Water &amp; irrigation</option>
<option data-cms="t018-الزراعة-البيئية-المحكومة" data-ar="الزراعة البيئية المحكومة" value="Controlled environment agriculture">Controlled environment agriculture</option>
<option data-cms="t019-البروتين-البديل" data-ar="البروتين البديل" value="Alternative protein">Alternative protein</option>
<option data-cms="t020-سلاسل-الإمداد-والخدمات-الل" data-ar="سلاسل الإمداد والخدمات اللوجستية" value="Supply chain & logistics">Supply chain &amp; logistics</option>
<option data-cms="t021-التقنية-الحيوية" data-ar="التقنية الحيوية" value="Biotechnology">Biotechnology</option>
<option data-cms="t022-الطاقة-المتجددة" data-ar="الطاقة المتجددة" value="Renewable energy">Renewable energy</option>
<option data-cms="t023-البيانات-والذكاء-الاصطناعي" data-ar="البيانات والذكاء الاصطناعي" value="Data & artificial intelligence">Data &amp; artificial intelligence</option>
<option data-cms="t024-البحث-والأوساط-الأكاديمية" data-ar="البحث والأوساط الأكاديمية" value="Research & academia">Research &amp; academia</option>
<option data-cms="t025-الجهات-الحكومية-والسياسات" data-ar="الجهات الحكومية والسياسات" value="Government & policy">Government &amp; policy</option>
<option data-cms="t026-الاستثمار-والتمويل" data-ar="الاستثمار والتمويل" value="Investment & funding">Investment &amp; funding</option>
<option data-cms="t027-غير-ربحي" data-ar="غير ربحي" value="Non-profit">Non-profit</option>
<option data-cms="t028-أخرى" data-ar="أخرى" value="Other">Other</option>
</select>
</div>
</div>

<div class="field">
<label data-cms="t032-الدولة" data-ar="الدولة" for="c-country">Country</label>
<select id="c-country" name="country">
<option data-cms="t033-الرجاء-الاختيار" data-ar="الرجاء الاختيار" value="">Please Select</option>
<option data-cms="t034-المملكة-العربية-السعودية" data-ar="المملكة العربية السعودية" value="Saudi Arabia">Saudi Arabia</option>
<option data-cms="t035-الإمارات-العربية-المتحدة" data-ar="الإمارات العربية المتحدة" value="United Arab Emirates">United Arab Emirates</option>
<option data-cms="t036-الكويت" data-ar="الكويت" value="Kuwait">Kuwait</option>
<option data-cms="t037-قطر" data-ar="قطر" value="Qatar">Qatar</option>
<option data-cms="t038-البحرين" data-ar="البحرين" value="Bahrain">Bahrain</option>
<option data-cms="t039-عُمان" data-ar="عُمان" value="Oman">Oman</option>
<option data-cms="t040-مصر" data-ar="مصر" value="Egypt">Egypt</option>
<option data-cms="t041-الأردن" data-ar="الأردن" value="Jordan">Jordan</option>
<option data-cms="t042-هولندا" data-ar="هولندا" value="Netherlands">Netherlands</option>
<option data-cms="t043-المملكة-المتحدة" data-ar="المملكة المتحدة" value="United Kingdom">United Kingdom</option>
<option data-cms="t044-الولايات-المتحدة" data-ar="الولايات المتحدة" value="United States">United States</option>
<option data-cms="t045-ألمانيا" data-ar="ألمانيا" value="Germany">Germany</option>
<option data-cms="t046-فرنسا" data-ar="فرنسا" value="France">France</option>
<option data-cms="t047-الصين" data-ar="الصين" value="China">China</option>
<option data-cms="t048-اليابان" data-ar="اليابان" value="Japan">Japan</option>
<option data-cms="t049-الهند" data-ar="الهند" value="India">India</option>
<option data-cms="t050-أستراليا" data-ar="أستراليا" value="Australia">Australia</option>
<option data-cms="t051-دولة-أخرى" data-ar="دولة أخرى" value="Other">Other</option>
</select>
</div>

<div class="form-actions">
<button class="btn-solid" type="submit"><span data-cms="t059-إرسال" data-ar="إرسال">Submit</span><svg fill="none" height="16" stroke="currentColor" stroke-width="1.6" viewBox="0 0 24 24" width="16"><path d="M5 12h13M13 6l6 6-6 6"></path></svg></button>
<span class="form-msg" id="cMsg"><svg fill="none" height="18" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" width="18"><path d="M20 6L9 17l-5-5"></path></svg><span data-cms="t060-تم-استلام-طلبك-سنتواصل-معك" data-ar="تم استلام طلبك. سنتواصل معك قريبًا.">Your request has been received. We will be in touch shortly.</span></span>
</div>

</form>
<aside class="aside-card reveal">
<h3 data-cms="t061-التواصل-المباشر" data-ar="التواصل المباشر">Direct contact</h3>
<p data-cms="t062-اختر-القناة-الأنسب-لطلبك-أ" class="aside-card__lede" data-ar="اختر القناة الأنسب لطلبك — أو استخدم النموذج وسنوجّهه للجهة الصحيحة.">Pick the channel that fits your request — or use the form and we will route it for you.</p>

<ul class="aside-list">
<li>
<span class="aside-list__ico"><svg fill="none" height="16" stroke="currentColor" stroke-width="1.7" viewBox="0 0 24 24" width="16"><rect height="15" rx="2.5" width="19" x="2.5" y="4.5"></rect><path d="M3 6.5l9 6.5 9-6.5"></path></svg></span>
<span><b data-cms="t063-الاستفسارات-العامة-والدعم" data-ar="الاستفسارات العامة والدعم">General enquiries and support</b><a href="mailto:secretariat@safta.sa">secretariat@safta.sa</a></span>
</li>
<li>
<span class="aside-list__ico"><svg fill="none" height="16" stroke="currentColor" stroke-width="1.7" viewBox="0 0 24 24" width="16"><path d="M12 5v14M5 12h14"></path></svg></span>
<span><b data-cms="t064-العضوية" data-ar="العضوية">Membership</b><a data-cms="t065-سجّل-اهتمامك-بالانضمام" data-ar="سجّل اهتمامك بالانضمام" href={`/${locale}/register-interest`}>Register your interest</a></span>
</li>
<li>
<span class="aside-list__ico"><svg fill="none" height="16" stroke="currentColor" stroke-width="1.7" viewBox="0 0 24 24" width="16"><path d="M4 5h16v14H4z"></path><path d="M8 9h8M8 13h5"></path></svg></span>
<span><b data-cms="t066-الاستفسارات-الإعلامية" data-ar="الاستفسارات الإعلامية">Media enquiries</b><a data-cms="t067-المركز-الإعلامي" data-ar="المركز الإعلامي" href={`/${locale}/media`}>Media Centre</a></span>
</li>
<li>
<span class="aside-list__ico"><svg fill="none" height="16" stroke="currentColor" stroke-width="1.7" viewBox="0 0 24 24" width="16"><circle cx="12" cy="12" r="9"></circle><path d="M12 7v5l3 2"></path></svg></span>
<span><b data-cms="t068-مدة-الرد" data-ar="مدة الرد">Response time</b><span data-cms="t069-ثلاثة-أيام-عمل-في-المتوسط" class="aside-list__txt" data-ar="ثلاثة أيام عمل في المتوسط.">Three working days on average.</span></span>
</li>
</ul>

<div class="aside-card__social">
<p data-cms="t070-تابعنا" data-ar="تابعنا">Follow us</p>
<div>
<a aria-label="LinkedIn" href="https://www.linkedin.com/company/saudi-agrifood-tech-alliance-safta/" rel="noopener" target="_blank"><svg fill="currentColor" height="15" viewBox="0 0 24 24" width="15"><path d="M4.98 3.5A2.5 2.5 0 1 0 5 8.5a2.5 2.5 0 0 0-.02-5zM3 9h4v12H3zM9 9h3.8v1.7h.05c.53-.95 1.83-1.95 3.77-1.95C20.4 8.75 21 11 21 14v7h-4v-6.2c0-1.5-.03-3.4-2.1-3.4-2.1 0-2.4 1.6-2.4 3.3V21H9z"></path></svg></a>
<a aria-label="X" href="https://x.com/SAFTA_KSA" rel="noopener" target="_blank"><svg fill="currentColor" height="15" viewBox="0 0 24 24" width="15"><path d="M18.9 2H22l-7 8 8.2 12h-6.4l-5-7.3L5.9 22H2.8l7.5-8.6L2.4 2h6.6l4.5 6.6L18.9 2z"></path></svg></a>
</div>
</div>
</aside>
</div>
</div>
</section>
</main>
<script slot="scripts" is:inline src="assets/content/contact.js?v=28"></script>
<script slot="scripts" is:inline src="assets/js/cms.js?v=28"></script>
</BaseLayout>
