---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Text from '../../components/content/Text.astro';
import Image from '../../components/content/Image.astro';
import { getSingleton } from '../../lib/content/cache';
import { english, pick } from '../../lib/bilingual';
import { challengeImages, FOUNDING_STATEMENT_IMG, imageFor } from '../../lib/safta-assets';
import { crumbHome } from '../../lib/ui';
import { isLocale } from '../../lib/locale';
import { youtubeEmbedUrl } from '../../lib/youtube';

export function getStaticPaths() {
  return [{ params: { locale: 'en' } }, { params: { locale: 'ar' } }];
}
const { locale } = Astro.params;
// The route renders on demand, so getStaticPaths does not constrain the param — /fr/about
// would otherwise render the English copy under lang="fr". isLocale is a type predicate,
// so this also narrows `locale` from string to 'en' | 'ar' for BaseLayout below.
if (!isLocale(locale)) return new Response(null, { status: 404 });

const hero = getSingleton('about_hero');
const mission = getSingleton('about_mission');
const glance = getSingleton('about_glance');
const roles = getSingleton('about_roles');
const challengesIntro = getSingleton('about_challenges_intro');
// The same list the home page's slider renders.
const challenges = getSingleton('challenges').items;
const founding = getSingleton('about_founding_statement');

// The reel is a YouTube link an admin pastes, not an uploaded file. youtubeEmbedUrl returns
// null for a blank value, which drops the video out of the layout below.
const reelEmbed = youtubeEmbedUrl(mission.youtubeUrl);

// The tape mixes both languages and mirrors on the switch: English reads "Soon · قريبًا ·…",
// Arabic "قريبًا · Soon ·…". So the second word is the field with its languages swapped.
const soon = pick(glance, 'soon');
const soonSwapped = { ar: english(soon), en: soon.ar };
---
<BaseLayout
  locale={locale}
  title="About SAFTA | SAFTA"
  titleAr="عن التحالف | التحالف السعودي لتقنيات الزراعة والغذاء"
  description="A national platform for collaboration, coordination and knowledge exchange in agrifood technology innovation, in support of Saudi Vision 2030."
  current="about"
>
<main>
<section class="page-hero page-hero--plain">
<div class="wrap">
<p class="crumbs"><Text as="a" field={crumbHome} href={`/${locale}`} /><span>/</span>About SAFTA</p>
<Text as="h1" field={pick(hero, 'title')} />
<Text as="p" field={pick(hero, 'lede')} class="lede" />
</div>
</section>
<section class="ribbon">
<div class="wrap">
<div class="sec-head reveal">
<div class="sec-head__txt">
<Text as="p" field={pick(mission, 'eyebrow')} class="eyebrow" />
<Text as="h2" field={pick(mission, 'heading')} class="h-section" />
</div>
</div>
<div class:list={['split', 'reveal', !reelEmbed && 'split--single']}>
<div>
{mission.paragraphs.map((para, i) => (
<Text as="p" field={pick(para, 'text')} style={i < mission.paragraphs.length - 1 ? 'font-size:17px;line-height:29px;margin-bottom:20px;' : 'font-size:17px;line-height:29px;'} />
))}
</div>
{reelEmbed && (
<figure class="video-embed" id="aboutReel">
<iframe src={reelEmbed} title={locale === 'ar' ? 'فيديو التحالف' : 'Alliance video'}
  loading="lazy" allowfullscreen
  allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
  referrerpolicy="strict-origin-when-cross-origin"></iframe>
</figure>
)}
</div>
</div>
</section>
<!-- «نظرة عامة / At a glance» stays hidden until about_glance.hidden is unticked in the dashboard -->
<section class="ribbon ribbon--grey glance glance--soon" aria-describedby="glanceSoon" hidden={glance.hidden}>
<div class="wrap reveal glance__panel">
<div class="soon-veil" id="glanceSoon" aria-hidden="true">
<span class="soon-tape"><Text as="b" field={soon} /><i>·</i><Text as="b" field={soonSwapped} /><i>·</i><Text as="b" field={soon} /><i>·</i><Text as="b" field={soonSwapped} /></span>
</div>
<Text as="h2" field={pick(glance, 'heading')} class="h-section" />
<div class="stats" style="grid-template-columns:repeat(4,1fr)">
{glance.stats.map((stat) => (
<div class="stat"><b data-count={stat.value}>0</b><Text as="p" field={pick(stat, 'label')} /></div>
))}
</div>
</div>
</section>
<section class="ribbon ribbon--grey">
<div class="wrap">
<div class="sec-head reveal">
<div class="sec-head__txt">
<Text as="p" field={pick(roles, 'eyebrow')} class="eyebrow" />
<Text as="h2" field={pick(roles, 'heading')} class="h-section" />
<Text as="p" field={pick(roles, 'lede')} class="lede" />
</div>
</div>
<div class="grid-4 reveal">
{roles.items.map((r, i) => (
  <div class="fact" style="border-top-width:2px;padding-top:22px">
    <b>{String(i + 1).padStart(2, '0')}</b>
    <Text as="h3" field={pick(r, 'title')} style="font-size:20px;font-weight:500;margin:6px 0 12px" />
    <Text as="p" field={pick(r, 'description')} style="font-size:15px;line-height:25px;color:var(--c-text-soft)" />
  </div>
))}
</div>
</div>
</section>
<section class="ribbon">
<div class="wrap">
<div class="sec-head reveal">
<div class="sec-head__txt">
<Text as="p" field={pick(challengesIntro, 'eyebrow')} class="eyebrow" />
<Text as="h2" field={pick(challengesIntro, 'heading')} class="h-section" />
<Text as="p" field={pick(challengesIntro, 'lede')} class="lede" />
</div>
</div>
<div class="grid-3 reveal">
{challenges.map((ch) => (
  <article class="tri__card">
    <figure><Image id={ch.imageId} fallback={imageFor(challengeImages, ch.id)} alt={english(pick(ch, 'title'))} loading="lazy" /></figure>
    <Text as="h3" field={pick(ch, 'title')} />
    <Text as="p" field={pick(ch, 'description')} />
  </article>
))}
</div>
</div>
</section>
<section class="ribbon">
<div class="wrap">
<div class="split reveal">
<figure><Image id={founding.imageId} fallback={FOUNDING_STATEMENT_IMG} alt="" /></figure>
<div>
<Text as="p" field={pick(founding, 'eyebrow')} class="eyebrow" />
<Text as="h3" field={pick(founding, 'quote')} style="font-family:var(--f-head);font-size:27px;line-height:38px;font-weight:500;margin:16px 0 24px" />
<a class="cta-circle" href={`/${locale}/members`}><Text as="span" field={pick(founding, 'ctaLabel')} /><span class="circ"><svg fill="none" height="16" stroke="currentColor" stroke-width="1.6" viewBox="0 0 24 24" width="16"><path d="M5 12h13M13 6l6 6-6 6"></path></svg></span></a>
</div>
</div>
</div>
</section>
</main>
</BaseLayout>
