---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Text from '../../components/content/Text.astro';
import Image from '../../components/content/Image.astro';
import { getPageContent } from '../../lib/content/store';
import { ABOUT_FIELDS } from '../../lib/content/schema/about';
import { isLocale } from '../../lib/locale';

export function getStaticPaths() {
  return [{ params: { locale: 'en' } }, { params: { locale: 'ar' } }];
}
const { locale } = Astro.params;
// The route renders on demand, so getStaticPaths does not constrain the param — /fr/about
// would otherwise render the English copy under lang="fr". isLocale is a type predicate,
// so this also narrows `locale` from string to 'en' | 'ar' for BaseLayout below.
if (!isLocale(locale)) return new Response(null, { status: 404 });

// Copy comes from ./content/about.json (gitignored, admin-owned), cached in memory. The
// <typeof ABOUT_FIELDS> type argument narrows c.text()/c.image() to this page's own keys,
// so a typo'd key or calling .text() on an image key is a compile-time error.
const c = await getPageContent<typeof ABOUT_FIELDS>('about');
---
<BaseLayout
  locale={locale}
  title="About SAFTA | SAFTA"
  titleAr="عن التحالف | التحالف السعودي لتقنيات الزراعة والغذاء"
  description="A national platform for collaboration, coordination and knowledge exchange in agrifood technology innovation, in support of Saudi Vision 2030."
  current="about"
>
<main>
<section class="page-hero page-hero--plain">
<div class="wrap">
<p class="crumbs"><Text as="a" key="t001-الرئيسية" field={c.text("t001-الرئيسية")} href={`/${locale}`} /><span>/</span>About SAFTA</p>
<Text as="h1" key="t002-عن-التحالف" field={c.text("t002-عن-التحالف")} />
<Text as="p" key="t003-منصة-وطنية-للتعاون-والتنسي" field={c.text("t003-منصة-وطنية-للتعاون-والتنسي")} class="lede" />
</div>
</section>
<section class="ribbon">
<div class="wrap">
<div class="sec-head reveal">
<div class="sec-head__txt">
<Text as="p" key="t004-الرسالة-والرؤية" field={c.text("t004-الرسالة-والرؤية")} class="eyebrow" />
<Text as="h2" key="t005-منصة-وطنية-لتسريع-تبنّي-تق" field={c.text("t005-منصة-وطنية-لتسريع-تبنّي-تق")} class="h-section" />
</div>
</div>
<div class="split reveal">
<div>
<Text as="p" key="t006-تأسّس-التحالف-السعودي-لتقن" field={c.text("t006-تأسّس-التحالف-السعودي-لتقن")} style="font-size:17px;line-height:29px;margin-bottom:20px;" />
<Text as="p" key="t007-يُعدّ-التحالف-أحد-أبرز-مخر" field={c.text("t007-يُعدّ-التحالف-أحد-أبرز-مخر")} style="font-size:17px;line-height:29px;" />
</div>
<figure class="vplay" id="aboutReel"
  data-src-mp4="assets/video/green-dunes-reel.mp4"
  data-src-webm="assets/video/green-dunes-reel.webm">
<Image key="i008-reelposter" field={c.image("i008-reelposter")} class="vplay__poster" loading="lazy" />
<button class="vplay__btn" type="button" aria-label="تشغيل الفيديو">
<svg viewBox="0 0 24 24" width="26" height="26" aria-hidden="true"><path d="M8 5v14l11-7z" fill="currentColor"/></svg>
<Text as="span" key="t009-شغّل-الفيديو" field={c.text("t009-شغّل-الفيديو")} />
</button>
<Text as="span" key="t010-٢٠-ثانية-بلا-صوت" field={c.text("t010-٢٠-ثانية-بلا-صوت")} class="vplay__meta" />
</figure>
</div>
</div>
</section>
<!-- v5: قسم «نظرة عامة / At a glance» مخفي مؤقتًا بطلب فريق سافتا — لإظهاره احذف hidden -->
<section class="ribbon ribbon--grey glance glance--soon" aria-describedby="glanceSoon" hidden>
<div class="wrap reveal glance__panel">
<div class="soon-veil" id="glanceSoon" aria-hidden="true">
<span class="soon-tape"><Text as="b" key="t011-قريبًا" field={c.text("t011-قريبًا")} /><i>·</i><Text as="b" key="t012-Soon" field={c.text("t012-Soon")} /><i>·</i><Text as="b" key="t013-قريبًا" field={c.text("t013-قريبًا")} /><i>·</i><Text as="b" key="t014-Soon" field={c.text("t014-Soon")} /></span>
</div>
<Text as="h2" key="t015-نظرة-عامة" field={c.text("t015-نظرة-عامة")} class="h-section" />
<div class="stats" style="grid-template-columns:repeat(4,1fr)">
<div class="stat"><b data-count="24">0</b><Text as="p" key="t016-مجموعة-عمل-مستهدفة" field={c.text("t016-مجموعة-عمل-مستهدفة")} /></div>
<div class="stat"><b data-count="4">0</b><Text as="p" key="t017-أدوار-مؤسسية-أساسية" field={c.text("t017-أدوار-مؤسسية-أساسية")} /></div>
<div class="stat"><b data-count="4">0</b><Text as="p" key="t018-قطاعات-ممثَّلة" field={c.text("t018-قطاعات-ممثَّلة")} /></div>
<div class="stat"><b data-count="3">0</b><Text as="p" key="t019-استراتيجيات-وطنية-متوائمة" field={c.text("t019-استراتيجيات-وطنية-متوائمة")} /></div>
</div>
</div>
</section>
<section class="ribbon">
<div class="wrap">
<div class="sec-head reveal">
<div class="sec-head__txt">
<Text as="p" key="t020-السياق-الوطني" field={c.text("t020-السياق-الوطني")} class="eyebrow" />
<Text as="h2" key="t021-تحديات-تجعل-الابتكار-ضرورة" field={c.text("t021-تحديات-تجعل-الابتكار-ضرورة")} class="h-section" />
<Text as="p" key="t022-تواجه-أنظمة-الزراعة-والغذا" field={c.text("t022-تواجه-أنظمة-الزراعة-والغذا")} class="lede" />
</div>
<a class="cta-circle" href={`/${locale}/technologies`}><Text as="span" key="t023-استعرض-مجموعات-العمل" field={c.text("t023-استعرض-مجموعات-العمل")} /><span class="circ"><svg fill="none" height="16" stroke="currentColor" stroke-width="1.6" viewBox="0 0 24 24" width="16"><path d="M5 12h13M13 6l6 6-6 6"></path></svg></span></a>
</div>
<div class="grid-3 reveal">
<article class="tri__card">
<figure><Image key="i024-phclimate" field={c.image("i024-phclimate")} /></figure>
<Text as="h3" key="t025-قسوة-الظروف-المناخية" field={c.text("t025-قسوة-الظروف-المناخية")} /><Text as="p" key="t026-ارتفاع-درجات-الحرارة-ومحدو" field={c.text("t026-ارتفاع-درجات-الحرارة-ومحدو")} />
</article><article class="tri__card">
<figure><Image key="i027-phwaterscarcity" field={c.image("i027-phwaterscarcity")} /></figure>
<Text as="h3" key="t028-شُح-الموارد-المائية" field={c.text("t028-شُح-الموارد-المائية")} /><Text as="p" key="t029-الزراعة-هي-أكبر-مستهلك-للم" field={c.text("t029-الزراعة-هي-أكبر-مستهلك-للم")} />
</article><article class="tri__card">
<figure><Image key="i030-phpests" field={c.image("i030-phpests")} /></figure>
<Text as="h3" key="t031-مخاطر-الآفات-الزراعية" field={c.text("t031-مخاطر-الآفات-الزراعية")} /><Text as="p" key="t032-خسائر-المحاصيل-بسبب-الآفات" field={c.text("t032-خسائر-المحاصيل-بسبب-الآفات")} />
</article><article class="tri__card">
<figure><Image key="i033-phsoil" field={c.image("i033-phsoil")} /></figure>
<Text as="h3" key="t034-تدهور-التربة" field={c.text("t034-تدهور-التربة")} /><Text as="p" key="t035-الملوحة-وتراجع-المادة-العض" field={c.text("t035-الملوحة-وتراجع-المادة-العض")} />
</article><article class="tri__card">
<figure><Image key="i036-phfoodwaste" field={c.image("i036-phfoodwaste")} /></figure>
<Text as="h3" key="t037-هدر-الغذاء" field={c.text("t037-هدر-الغذاء")} /><Text as="p" key="t038-الفاقد-بين-الحصاد-والاستهل" field={c.text("t038-الفاقد-بين-الحصاد-والاستهل")} />
</article>
</div>
</div>
</section>
<section class="ribbon ribbon--grey">
<div class="wrap">
<div class="sec-head reveal">
<div class="sec-head__txt">
<Text as="p" key="t039-الأدوار-المؤسسية" field={c.text("t039-الأدوار-المؤسسية")} class="eyebrow" />
<Text as="h2" key="t040-أربعة-أدوار-توجّه-عمل-التح" field={c.text("t040-أربعة-أدوار-توجّه-عمل-التح")} class="h-section" />
<Text as="p" key="t041-انبثق-التحالف-عن-الخطة-الت" field={c.text("t041-انبثق-التحالف-عن-الخطة-الت")} class="lede" />
</div>
</div>
<div class="grid-4 reveal">
<div class="fact" style="border-top-width:2px;padding-top:22px">
<b>01</b><Text as="h3" key="t042-توجيه-الابتكار" field={c.text("t042-توجيه-الابتكار")} style="font-size:20px;font-weight:500;margin:6px 0 12px" />
<Text as="p" key="t043-رصد-التقنيات-الناشئة-والمس" field={c.text("t043-رصد-التقنيات-الناشئة-والمس")} style="font-size:15px;line-height:25px;color:var(--c-text-soft)" /></div><div class="fact" style="border-top-width:2px;padding-top:22px">
<b>02</b><Text as="h3" key="t044-بناء-الشراكات" field={c.text("t044-بناء-الشراكات")} style="font-size:20px;font-weight:500;margin:6px 0 12px" />
<Text as="p" key="t045-إنشاء-وتعزيز-الروابط-بين-ا" field={c.text("t045-إنشاء-وتعزيز-الروابط-بين-ا")} style="font-size:15px;line-height:25px;color:var(--c-text-soft)" /></div><div class="fact" style="border-top-width:2px;padding-top:22px">
<b>03</b><Text as="h3" key="t046-تحفيز-الطلب-على-الابتكار" field={c.text("t046-تحفيز-الطلب-على-الابتكار")} style="font-size:20px;font-weight:500;margin:6px 0 12px" />
<Text as="p" key="t047-تسهيل-تبنّي-التقنية-وإزالة" field={c.text("t047-تسهيل-تبنّي-التقنية-وإزالة")} style="font-size:15px;line-height:25px;color:var(--c-text-soft)" /></div><div class="fact" style="border-top-width:2px;padding-top:22px">
<b>04</b><Text as="h3" key="t048-تمكين-عرض-الابتكار" field={c.text("t048-تمكين-عرض-الابتكار")} style="font-size:20px;font-weight:500;margin:6px 0 12px" />
<Text as="p" key="t049-تمكين-الشركات-الناشئة-والم" field={c.text("t049-تمكين-الشركات-الناشئة-والم")} style="font-size:15px;line-height:25px;color:var(--c-text-soft)" /></div>
</div>
</div>
</section>
<section class="ribbon">
<div class="wrap">
<div class="split reveal">
<figure><Image key="i050-phmembership" field={c.image("i050-phmembership")} /></figure>
<div>
<Text as="p" key="t051-البيان-التأسيسي" field={c.text("t051-البيان-التأسيسي")} class="eyebrow" />
<Text as="h3" key="t052-يمثّل-تأسيسه-فرصة-تاريخية-" field={c.text("t052-يمثّل-تأسيسه-فرصة-تاريخية-")} style="font-family:var(--f-head);font-size:27px;line-height:38px;font-weight:500;margin:16px 0 24px" />
<a class="cta-circle" href={`/${locale}/members`}><Text as="span" key="t053-تعرّف-على-المتحالفين" field={c.text("t053-تعرّف-على-المتحالفين")} /><span class="circ"><svg fill="none" height="16" stroke="currentColor" stroke-width="1.6" viewBox="0 0 24 24" width="16"><path d="M5 12h13M13 6l6 6-6 6"></path></svg></span></a>
</div>
</div>
</div>
</section>
</main>
</BaseLayout>
