---
import BaseLayout from '../../layouts/BaseLayout.astro';

export function getStaticPaths() {
  return [{ params: { locale: 'en' } }, { params: { locale: 'ar' } }];
}
const { locale } = Astro.params;
---
<BaseLayout
  locale={locale}
  title="Cookie Notice | SAFTA"
  titleAr="إشعار ملفات الارتباط | التحالف السعودي"
>
<main>
<section class="page-hero page-hero--plain">
<div class="wrap">
<p class="crumbs"><a data-ar="الرئيسية" href={`/${locale}`}>Home</a><span>/</span>Cookie Notice</p>
<h1 data-ar="إشعار ملفات الارتباط">Cookie Notice</h1>
</div>
</section>
<section class="ribbon"><div class="wrap"><div class="prose reveal"><p class="updated" data-ar="آخر تحديث: 3 أغسطس 2026">Last updated: August 3, 2026</p><h2 data-ar="ما هي ملفات الارتباط">What cookies are</h2><p data-ar="ملفات الارتباط ملفات نصية صغيرة تُحفظ على جهازك عند زيارة الموقع، وتتيح للموقع تذكّر خياراتك وقياس طريقة استخدامه.">Cookies are small text files placed on your device when you visit a website. They allow the site to remember your choices and to measure how the site is used.</p><h2 data-ar="الفئات التي نستخدمها">Categories we use</h2><ul><li data-ar="&lt;b&gt;ضرورية تمامًا:&lt;/b&gt; لازمة لعمل الموقع، وتشمل تفضيلات اللغة وإمكانية الوصول، ولا يمكن إيقافها."><b data-ar="ضرورية تمامًا:">Strictly necessary:</b> required for the site to function, including language and accessibility preferences. These cannot be switched off.</li><li data-ar="&lt;b&gt;الأداء:&lt;/b&gt; إحصاءات مجهولة عن الصفحات المُشاهَدة والوقت المستغرق، تُستخدم لتحسين المحتوى."><b data-ar="الأداء:">Performance:</b> anonymous statistics on pages viewed and time spent, used to improve content.</li><li data-ar="&lt;b&gt;الوظيفية:&lt;/b&gt; تذكّر خيارات مثل عوامل التصفية المحددة في صفحتي المتحالفين ومجموعات العمل."><b data-ar="الوظيفية:">Functional:</b> remember choices such as selected filters on the Members and Working Groups pages.</li></ul><h2 data-ar="الإعلانات">Advertising</h2><p data-ar="لا يستخدم هذا الموقع ملفات ارتباط إعلانية أو للتتبّع عبر المواقع.">This site does not use advertising or cross-site tracking cookies.</p><h2 data-ar="إدارة ملفات الارتباط">Managing cookies</h2><p data-ar="يمكنك حذف ملفات الارتباط أو حظرها من إعدادات المتصفح. وقد يؤدي حظر الملفات الضرورية إلى تعطّل أجزاء من الموقع.">You can delete or block cookies through your browser settings. Blocking strictly necessary cookies may prevent parts of the site from working.</p><h2 data-ar="تواصل معنا">Contact</h2><p>Questions about cookies: <a href="mailto:secretariat@safta.sa" style="color:var(--c-link)">secretariat@safta.sa</a>.</p></div></div></section>
</main>
</BaseLayout>
