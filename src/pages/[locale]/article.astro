---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Text from '../../components/content/Text.astro';
import Image from '../../components/content/Image.astro';
import { getArticle, getSingleton } from '../../lib/content/cache';
import { english, pick } from '../../lib/bilingual';
import { ARTICLE_IMG } from '../../lib/safta-assets';
import { crumbHome } from '../../lib/ui';
import { isLocale } from '../../lib/locale';

export function getStaticPaths() {
  return [{ params: { locale: 'en' } }, { params: { locale: 'ar' } }];
}
const { locale } = Astro.params;
if (!isLocale(locale)) return new Response(null, { status: 404 });

// `?id=` is the article's slug. With none, send the visitor to the list; an unknown or
// unpublished one is a 404 (it used to show the first article instead).
const id = Astro.url.searchParams.get('id');
if (!id) return Astro.redirect(`/${locale}/media`);
const article = getArticle(id);
if (!article) return new Response(null, { status: 404 });

const chrome = getSingleton('article_chrome');
const title = pick(article, 'title');
const quote = pick(article, 'quote');
---
<BaseLayout
  locale={locale}
  title={`${english(title)} | SAFTA`}
  titleAr={`${title.ar} | التحالف السعودي`}
>
<main>
<article class="art">

<header class="art__hero">
<Image media={article.imageId ?? chrome.defaultImageId} fallback={ARTICLE_IMG} alt="" id="aImg" />
<div class="art__scrim"></div>
<div class="wrap">
<p class="crumbs"><Text as="a" field={crumbHome} href={`/${locale}`} /><span>/</span><Text as="a" field={pick(chrome, 'crumbMedia')} href={`/${locale}/media`} /><span>/</span><Text as="span" id="aKind" field={pick(article, 'kind')} /></p>
<Text as="h1" id="aTitle" field={title} />
<p class="art__meta"><Text as="span" id="aDate" field={pick(article, 'date')} /><i></i><Text as="span" id="aRead" field={pick(article, 'readTime')} /></p>
</div>
</header>

<div class="wrap">
<div class="art__body reveal">
<Text as="p" class="art__lede" id="aLede" field={pick(article, 'lede')} />
<div id="aSections">
{article.blocks.map((block) => (
  <>
    <Text as="h2" field={pick(block, 'heading')} />
    <Text as="p" field={pick(block, 'body')} />
  </>
))}
</div>
<figure class="art__quote" hidden={!quote.ar && !quote.en} id="aQuote"><blockquote><Text as="span" id="aQuoteTxt" field={quote} /></blockquote><figcaption><Text as="span" id="aQuoteBy" field={pick(article, 'quoteBy')} /></figcaption></figure>
<div class="art__tags" id="aTags">
{article.tags.map((tag) => (
  <Text as="span" class="art__tag" field={pick(tag, 'label')} />
))}
</div>
</div>

<div class="art__nav reveal">
<Text as="a" class="btn-pill" field={pick(chrome, 'backLabel')} href={`/${locale}/media`} />
<Text as="a" class="btn-pill btn-pill--alt" field={pick(chrome, 'registerLabel')} href={`/${locale}/register-interest`} />
</div>
</div>

</article>
</main>
</BaseLayout>
