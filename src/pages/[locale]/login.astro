---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { isLocale } from '../../lib/locale';

export function getStaticPaths() {
  return [{ params: { locale: 'en' } }, { params: { locale: 'ar' } }];
}
const { locale } = Astro.params;
if (!isLocale(locale)) return new Response(null, { status: 404 });

// The form posts to /api/login, which signs in through Better Auth and redirects back
// here with ?error= when that fails.
const ERRORS: Record<string, { en: string; ar: string }> = {
  missing: { en: 'Enter your email and password.', ar: 'أدخل البريد الإلكتروني وكلمة المرور.' },
  invalid: { en: 'Incorrect email or password.', ar: 'البريد الإلكتروني أو كلمة المرور غير صحيحة.' },
};
const errorMessage = ERRORS[Astro.url.searchParams.get('error') ?? ''] ?? null;
---
<BaseLayout
  locale={locale}
  title="Login | SAFTA"
  titleAr="تسجيل الدخول | التحالف السعودي"
>
<main>
<section class="page-hero page-hero--plain">
<div class="wrap">
<p class="crumbs"><a data-ar="الرئيسية" href={`/${locale}`}>Home</a><span>/</span>Login</p>
<h1 data-ar="دخول الأعضاء">Members login</h1>
</div>
</section>
<section class="ribbon">
<div class="wrap">
<div class="login-shell reveal">
<p class="eyebrow" data-ar="منطقة الأعضاء" style="text-align:center">Members area</p>
<h2 class="h-section" data-ar="تسجيل الدخول" style="text-align:center;margin-top:12px">Sign in</h2>
<p class="lede" data-ar="دخول أعضاء التحالف إلى مركز تحكّم المحتوى." style="text-align:center;margin-top:14px">Alliance members sign in to the content control centre.</p>
<form class="form" id="loginForm" method="POST" action="/api/login" style="margin-top:38px">
<input type="hidden" name="locale" value={locale}/>
<div class="field"><label data-ar="البريد الإلكتروني" for="l-user">Email</label><input autocapitalize="off" autocomplete="username" dir="ltr" id="l-user" name="email" required="" spellcheck="false" type="email"/></div>
<div class="field"><label data-ar="كلمة المرور" for="l-pass">Password</label><input autocomplete="current-password" dir="ltr" id="l-pass" name="password" required="" type="password"/></div>
<label class="check"><input type="checkbox" name="rememberMe"/><span data-ar="أبقني مسجّلاً على هذا الجهاز">Keep me signed in on this device</span></label>
<div class="form-actions" style="flex-direction:column;align-items:stretch">
<button class="btn-solid" style="justify-content:center" type="submit"><span data-ar="تسجيل الدخول">Sign in</span><svg fill="none" height="16" stroke="currentColor" stroke-width="1.6" viewBox="0 0 24 24" width="16"><path d="M5 12h13M13 6l6 6-6 6"></path></svg></button>
{errorMessage && (
<span class="form-msg" id="lMsg" data-ar={errorMessage.ar} style="justify-content:center;color:#D32F2F">{errorMessage.en}</span>
)}
</div>
</form>
<p class="login-note">Not a member yet? <a data-ar="سجّل اهتمامك" href={`/${locale}/register-interest`} style="color:var(--c-link)">Register your interest</a>  ·  <a data-ar="نسيت كلمة المرور" href={`/${locale}/forgot-password`} style="color:var(--c-link)">Forgot password</a></p>
</div>
</div>
</section>
</main>
</BaseLayout>
