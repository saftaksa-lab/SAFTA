---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Text from '../../components/content/Text.astro';
import Image from '../../components/content/Image.astro';
import { getSingleton, listArticles, listEvents } from '../../lib/content/cache';
import { isExternal, localizeHref, pick } from '../../lib/bilingual';
import { ARTICLE_IMG } from '../../lib/safta-assets';
import { crumbHome } from '../../lib/ui';
import { isLocale } from '../../lib/locale';

export function getStaticPaths() {
  return [{ params: { locale: 'en' } }, { params: { locale: 'ar' } }];
}
const { locale } = Astro.params;
if (!isLocale(locale)) return new Response(null, { status: 404 });

const banner = getSingleton('media_banner');
const articles = listArticles();
// An article without its own image shows the article page's default hero, as on its page.
const defaultImageId = getSingleton('article_chrome').defaultImageId;
// The event href is validated on save (no `javascript:` and the like), so it only needs
// this locale's prefix when it is an on-site path.
const events = listEvents().map((e) => ({ ...e, href: localizeHref(locale, e.href) }));
---
<BaseLayout
  locale={locale}
  title="Media | SAFTA"
  titleAr="المركز الإعلامي | التحالف السعودي"
  description="News, insights, photography and events from across the Alliance."
>
<main>
<section class="page-hero page-hero--plain">
<div class="wrap">
<p class="crumbs"><Text as="a" field={crumbHome} href={`/${locale}`} /><span>/</span>News &amp; Events</p>
<Text as="h1" field={pick(banner, 'title')} />
<Text as="p" field={pick(banner, 'lede')} class="lede" />
</div>
</section>
<section class="ribbon">
<div class="wrap">
<div class="mtabs" role="tablist" aria-label="News & Events">
<button class="mtab is-active" type="button" role="tab" aria-selected="true" data-mtab="news" data-ar="الأخبار">News</button>
<button class="mtab" type="button" role="tab" aria-selected="false" data-mtab="events" data-ar="الفعاليات والمعارض">Events &amp; exhibitions</button>
</div>
<div class="mtab-panel is-active" id="news" role="tabpanel">
<div class="card-row bleed reveal">
{articles.map((a) => (
  <a class="news-card" href={`/${locale}/article?id=${a.slug}`}>
    <div class="news-card__media"><Image media={a.imageId ?? defaultImageId} fallback={ARTICLE_IMG} alt="" /></div>
    <div class="news-card__body"><Text as="p" field={pick(a, 'date')} class="news-card__meta" /><Text as="h3" field={pick(a, 'title')} /></div>
    <div class="news-card__foot"><span class="circ-sm"><svg fill="none" height="13" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" width="13"><path d="M5 12h13M13 6l6 6-6 6"></path></svg></span></div>
  </a>
))}
</div>
</div>
<div class="mtab-panel" id="events" role="tabpanel" hidden>
<div class="reveal" id="eventsList">
{events.map((e) => (
  <div class="event">
    <div class="event__date"><b>{e.day}</b><Text as="span" field={pick(e, 'month')} /></div>
    <div>
      <Text as="h3" field={pick(e, 'title')} />
      <Text as="p" field={pick(e, 'description')} />
    </div>
    <a class="cta-circle" href={e.href} target={isExternal(e.href) ? '_blank' : undefined} rel={isExternal(e.href) ? 'noopener' : undefined}>
      <span data-ar="التفاصيل">Details</span>
      <span class="circ"><svg fill="none" height="16" stroke="currentColor" stroke-width="1.6" viewBox="0 0 24 24" width="16"><path d="M5 12h13M13 6l6 6-6 6"></path></svg></span>
    </a>
  </div>
))}
</div>
</div>



</div>
</section>
</main>
</BaseLayout>
