---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Text from '../../components/content/Text.astro';
import Image from '../../components/content/Image.astro';
import { getPageContent } from '../../lib/content/store';
import { MEDIA_FIELDS } from '../../lib/content/schema/media';
import { getCollectionContent } from '../../lib/content/collections/store';
import { EVENTS_FIELDS } from '../../lib/content/collections/events';
import { isLocale } from '../../lib/locale';

export function getStaticPaths() {
  return [{ params: { locale: 'en' } }, { params: { locale: 'ar' } }];
}
const { locale } = Astro.params;
if (!isLocale(locale)) return new Response(null, { status: 404 });

const c = await getPageContent<typeof MEDIA_FIELDS>('media');

// Ported verbatim from assets/js/main.js's former module 24 (events-list IIFE) — blocks
// javascript:/data:/vbscript: hrefs on an admin-controlled link, defaulting to
// register-interest instead.
function safeHref(u: string) {
  const trimmed = String(u ?? '').trim();
  if (!trimmed) return '/register-interest';
  if (/^\s*(javascript|data|vbscript):/i.test(trimmed)) return '/register-interest';
  return trimmed;
}
function isExternal(u: string) {
  return /^https?:\/\//i.test(u);
}

const events = await getCollectionContent<typeof EVENTS_FIELDS>('events');
const eventItems = events.items().map((e) => ({
  id: e.id,
  day: e.value('day'),
  month: e.text('month'),
  title: e.text('title'),
  desc: e.text('desc'),
  href: safeHref(e.value('link')),
}));
---
<BaseLayout
  locale={locale}
  title="Media | SAFTA"
  titleAr="المركز الإعلامي | التحالف السعودي"
  description="News, insights, photography and events from across the Alliance."
>
<main>
<section class="page-hero page-hero--plain">
<div class="wrap">
<p class="crumbs"><Text as="a" key="t001-الرئيسية" field={c.text("t001-الرئيسية")} href={`/${locale}`} /><span>/</span>News &amp; Events</p>
<Text as="h1" key="t002-المركز-الإعلامي" field={c.text("t002-المركز-الإعلامي")} />
<Text as="p" key="t003-الأخبار-والرؤى-والصور-والف" field={c.text("t003-الأخبار-والرؤى-والصور-والف")} class="lede" />
</div>
</section>
<section class="ribbon">
<div class="wrap">
<p class="demo-note"><svg fill="none" height="17" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" width="17"><circle cx="12" cy="12" r="9"></circle><path d="M12 8h.01M11 12h1v4h1"></path></svg><Text as="span" key="t004-بيانات-تجريبية-المدخلات-في" field={c.text("t004-بيانات-تجريبية-المدخلات-في")}><b>Demo data.</b> The entries on this page are placeholders used to show the layout. Replace them with the Alliance’s real records before launch.</Text></p>
<div class="mtabs" role="tablist" aria-label="News & Events">
<button class="mtab is-active" type="button" role="tab" aria-selected="true" data-mtab="news" data-ar="الأخبار">News</button>
<button class="mtab" type="button" role="tab" aria-selected="false" data-mtab="events" data-ar="الفعاليات والمعارض">Events &amp; exhibitions</button>
</div>
<div class="mtab-panel is-active" id="news" role="tabpanel">
<div class="card-row bleed reveal"><a class="news-card" href={`/${locale}/article?id=mou-water`}>
<div class="news-card__media"><Image key="i005-phnews" field={c.image("i005-phnews")} /></div>
<div class="news-card__body"><Text as="p" key="t006-أخبار-28-يوليو-2026" field={c.text("t006-أخبار-28-يوليو-2026")} class="news-card__meta" /><Text as="h3" key="t007-التحالف-ووزارة-البيئة-والم" field={c.text("t007-التحالف-ووزارة-البيئة-والم")} /></div>
<div class="news-card__foot"><span class="circ-sm"><svg fill="none" height="13" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" width="13"><path d="M5 12h13M13 6l6 6-6 6"></path></svg></span></div>
</a><a class="news-card" href={`/${locale}/article?id=first-cohort`}>
<div class="news-card__media"><Image key="i008-phmembership" field={c.image("i008-phmembership")} /></div>
<div class="news-card__body"><Text as="p" key="t009-أخبار-14-يوليو-2026" field={c.text("t009-أخبار-14-يوليو-2026")} class="news-card__meta" /><Text as="h3" key="t010-انعقاد-الدفعة-الأولى-من-مج" field={c.text("t010-انعقاد-الدفعة-الأولى-من-مج")} /></div>
<div class="news-card__foot"><span class="circ-sm"><svg fill="none" height="13" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" width="13"><path d="M5 12h13M13 6l6 6-6 6"></path></svg></span></div>
</a><a class="news-card" href={`/${locale}/article?id=loi-2026`}>
<div class="news-card__media"><Image key="i011-phinsight02" field={c.image("i011-phinsight02")} /></div>
<div class="news-card__body"><Text as="p" key="t012-أخبار-30-يونيو-2026" field={c.text("t012-أخبار-30-يونيو-2026")} class="news-card__meta" /><Text as="h3" key="t013-التحالف-ينشر-خطاب-الاهتمام" field={c.text("t013-التحالف-ينشر-خطاب-الاهتمام")} /></div>
<div class="news-card__foot"><span class="circ-sm"><svg fill="none" height="13" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" width="13"><path d="M5 12h13M13 6l6 6-6 6"></path></svg></span></div>
</a><a class="news-card" href={`/${locale}/article?id=precision-pilots`}>
<div class="news-card__media"><Image key="i014-phwhatwedo" field={c.image("i014-phwhatwedo")} /></div>
<div class="news-card__body"><Text as="p" key="t015-أخبار-09-يونيو-2026" field={c.text("t015-أخبار-09-يونيو-2026")} class="news-card__meta" /><Text as="h3" key="t016-التحالف-يشارك-مراكز-بحثية-" field={c.text("t016-التحالف-يشارك-مراكز-بحثية-")} /></div>
<div class="news-card__foot"><span class="circ-sm"><svg fill="none" height="13" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" width="13"><path d="M5 12h13M13 6l6 6-6 6"></path></svg></span></div>
</a></div>
</div>
<div class="mtab-panel" id="events" role="tabpanel" hidden>
<div class="reveal" id="eventsList">
{eventItems.map((e) => (
  <div class="event">
    <div class="event__date"><b>{e.day}</b><span data-ar={e.month.ar || e.month.en}>{e.month.en || e.month.ar}</span></div>
    <div>
      <h3 data-ar={e.title.ar || e.title.en}>{e.title.en || e.title.ar}</h3>
      <p data-ar={e.desc.ar || e.desc.en}>{e.desc.en || e.desc.ar}</p>
    </div>
    <a class="cta-circle" href={e.href} target={isExternal(e.href) ? '_blank' : undefined} rel={isExternal(e.href) ? 'noopener' : undefined}>
      <span data-ar="التفاصيل">Details</span>
      <span class="circ"><svg fill="none" height="16" stroke="currentColor" stroke-width="1.6" viewBox="0 0 24 24" width="16"><path d="M5 12h13M13 6l6 6-6 6"></path></svg></span>
    </a>
  </div>
))}
</div>
</div>



</div>
</section>
</main>
</BaseLayout>
