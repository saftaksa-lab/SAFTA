---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Text from '../../components/content/Text.astro';
import Image from '../../components/content/Image.astro';
import { getSingleton } from '../../lib/content/cache';
import { english, localizeHref, pick } from '../../lib/bilingual';
import { DISCOVER_IMG, heroImages, imageFor, partnerLogos } from '../../lib/safta-assets';
import { challengeIcons } from '../../lib/challenge-icons';
import { isLocale } from '../../lib/locale';

export function getStaticPaths() {
  return [{ params: { locale: 'en' } }, { params: { locale: 'ar' } }];
}
const { locale } = Astro.params;
if (!isLocale(locale)) return new Response(null, { status: 404 });

const hero = getSingleton('home_hero');
const discover = getSingleton('home_discover');
const challengesIntro = getSingleton('home_challenges_intro');
// One list behind both these cards and the about page's grid.
const challenges = getSingleton('challenges').items;
const awards = getSingleton('home_awards');
const partners = getSingleton('home_partners').items;
---
<BaseLayout
  locale={locale}
  title="Where technology feeds the future | SAFTA"
  titleAr="حيث تُغذّي التقنية المستقبل | التحالف السعودي لتقنيات الزراعة والغذاء"
  description="SAFTA — the Saudi AgriFood Tech Alliance. A national platform accelerating agrifood technology adoption across the Kingdom."
  current="index"
  appleTouchIcon
>
<main>
<!-- =============== 1. HERO CAROUSEL =============== -->
<section class="hero" id="hero">
<div class="hero__stage">

{hero.panels.map((panel, i) => (
<div class:list={['hero__slide', i === 0 && 'is-active']} data-slide={i}>
<Image media={panel.imageId} fallback={imageFor(heroImages, panel.id)} alt="" />
</div>
))}

<div class="hero__scrim"></div>

<div class="wrap hero__copy">

{hero.panels.map((panel, i) => (
<div class:list={['hero__panel', i === 0 && 'is-active']} data-panel={i}>
<Text as="p" field={pick(panel, 'eyebrow')} class="eyebrow eyebrow--light" />
<Text as={i === 0 ? 'h1' : 'h2'} field={pick(panel, 'heading')} class="h-display" />
<div class="hero__actions">
<a class="cta-circle cta-circle--light" href={localizeHref(locale, panel.ctaHref)}>
<Text as="span" field={pick(panel, 'ctaLabel')} />
<span class="circ"><svg fill="none" height="16" stroke="currentColor" stroke-width="1.6" viewBox="0 0 24 24" width="16"><path d="M5 12h13M13 6l6 6-6 6"></path></svg></span>
</a>
</div>
</div>
))}

</div>
</div>

<div class="hero__tabs">
<div class="wrap">
{hero.panels.map((panel, i) => (
<button class:list={['hero-tab', i === 0 && 'is-active']} data-tab={i} type="button"><Text as="span" field={pick(panel, 'eyebrow')} /><i></i></button>
))}
</div>
</div>
</section>
<!-- =============== 2. DISCOVER SAFTA =============== -->
<section class="ribbon ribbon--grey discover">
<div class="wrap">
<div class="discover__intro reveal">
<Text as="p" field={pick(discover, 'eyebrow')} class="eyebrow" />
<Text as="h2" field={pick(discover, 'intro')} class="h-intro" />
</div>
<div class="wg-feature reveal">
<div class="wg-feature__txt">
<Text as="h3" field={pick(discover, 'title')} class="h-section" />
<Text as="p" field={pick(discover, 'lede')} class="wg-feature__lede" />
<Text as="p" field={pick(discover, 'body')} class="lede" />
<a class="btn-brand" href={localizeHref(locale, discover.href)}>
<Text as="span" field={pick(discover, 'ctaLabel')} />
<svg fill="none" height="15" stroke="currentColor" stroke-width="1.9" viewBox="0 0 24 24" width="15"><path d="M5 12h13M13 6l6 6-6 6"></path></svg>
</a>
</div>
<figure class="wg-feature__media">
<Image media={discover.imageId} fallback={DISCOVER_IMG} loading="lazy" />
</figure>
</div>
</div>
</section>
<!-- =============== 3. CHALLENGES =============== -->
<section class="ribbon challenges" id="challenges">
<div class="wrap">
<Text as="h2" field={pick(challengesIntro, 'title')} class="h-section challenges__title reveal" />
<div class="chcards reveal">
{challenges.map((ch) => (
  <article class="chcard">
    <div class="chcard__head">
      <span class="chcard__icon" aria-hidden="true"><svg fill="none" height="24" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.7" viewBox="0 0 24 24" width="24" set:html={challengeIcons[ch.icon]} /></span>
      <Text as="h3" field={pick(ch, 'title')} />
    </div>
    <Text as="p" field={pick(ch, 'description')} />
  </article>
))}
</div>
</div>
</section>
<!-- =============== 9b. SAFTA EXCELLENCE AWARDS =============== -->
{!awards.hidden && (
<section class="ribbon awards" id="awards">
<div class="wrap">
<div class="awards__panel reveal">
<div class="awards__head">
<span class="soon-pill" role="status"><i class="soon-pill__dot" aria-hidden="true"></i><Text as="span" field={pick(awards, 'soonLabel')} /></span>
<Text as="p" field={pick(awards, 'eyebrow')} class="eyebrow eyebrow--light" />
<Text as="h2" field={pick(awards, 'heading')} class="h-section" />
<Text as="p" field={pick(awards, 'lede')} class="lede" />
<a class="btn-brand" href={`/${locale}/register-interest`}>
<Text as="span" field={pick(awards, 'ctaLabel')} />
<svg fill="none" height="15" stroke="currentColor" stroke-width="1.9" viewBox="0 0 24 24" width="15"><path d="M5 12h13M13 6l6 6-6 6"></path></svg>
</a>
</div>
<ol class="awards__cats">
{awards.categories.map((cat, i) => (
<li class="award">
<span class="award__no" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
<Text as="h3" field={pick(cat, 'title')} />
<Text as="p" field={pick(cat, 'description')} />
<i class="award__rule"></i>
</li>
))}
</ol>
</div>
</div>
</section>
)}
</main>
<!-- =============== 1b. PARTNER LOGO STRIP =============== -->
<!-- شعارات رسمية مستخرجة من أوراق سياسات التحالف الرسمية
     (المواجز التنفيذية العربية · نوفمبر 2025). المصدر ملف صادر عن
     التحالف نفسه، فالاستخدام هنا مبرَّر. الترتيب أبجدي لا تفضيلي. -->
<section class="partners" aria-label="Alliance partners">
<div class="wrap">
<p class="partners__label" data-ar="الشراكات الاستراتيجية">Strategic partnerships</p>
<div class="partners__viewport">
<div class="partners__track">
{partners.map((p) => (
  <a class="partner" href={p.url ?? `/${locale}/members`} title={english(pick(p, 'name'))}>
    <Image media={p.logoId} fallback={imageFor(partnerLogos, p.id)} alt={english(pick(p, 'name'))} loading="lazy" />
  </a>
))}
</div>
</div>
<p class="partners__note" data-ar="الجهات الشريكة استراتيجيًا في تأسيس التحالف وتفعيل مجموعات عمله.">The strategic partners behind the Alliance's establishment and the activation of its working groups.</p>
</div>
</section>
</BaseLayout>
