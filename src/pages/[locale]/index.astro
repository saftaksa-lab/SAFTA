---
import BaseLayout from '../../layouts/BaseLayout.astro';

export function getStaticPaths() {
  return [{ params: { locale: 'en' } }, { params: { locale: 'ar' } }];
}
const { locale } = Astro.params;
---
<BaseLayout
  locale={locale}
  title="Where technology feeds the future | SAFTA"
  titleAr="حيث تُغذّي التقنية المستقبل | التحالف السعودي لتقنيات الزراعة والغذاء"
  description="SAFTA — the Saudi AgriFood Tech Alliance. A national platform accelerating agrifood technology adoption across the Kingdom."
  current="index"
  appleTouchIcon
>
<main>
<!-- =============== 1. HERO CAROUSEL =============== -->
<section class="hero" id="hero">
<div class="hero__stage">

<div class="hero__slide is-active" data-slide="0">
<img data-cms-img="i001-gd02bedshero" alt="" src="assets/img/green-dunes/gd-02-beds-hero.webp"/>
</div>
<div class="hero__slide" data-slide="1">
<img data-cms-img="i002-gd03rowshero" alt="" src="assets/img/green-dunes/gd-03-rows-hero.webp"/>
</div>
<div class="hero__slide" data-slide="2">
<img data-cms-img="i003-gd09rackshero" alt="" src="assets/img/green-dunes/gd-09-racks-hero.webp"/>
</div>

<div class="hero__scrim"></div>

<div class="wrap hero__copy">

<div class="hero__panel is-active" data-panel="0">
<p data-cms="t004-رؤى-سافتا" class="eyebrow eyebrow--light" data-ar="رؤى سافتا">SAFTA Insights</p>
<h1 data-cms="t005-معرفة-تطبيقية-تدعم-قرارات-" class="h-display" data-ar="معرفة تطبيقية تدعم قرارات تبنّي تقنيات الزراعة والغذاء في المملكة.">Applied knowledge that supports technology-adoption decisions across the Kingdom's agrifood sector.</h1>
<div class="hero__actions">
<a class="cta-circle cta-circle--light" href={`/${locale}/about`}>
<span data-cms="t006-استعرض-الرؤى" data-ar="استعرض الرؤى">Explore Insights</span>
<span class="circ"><svg fill="none" height="16" stroke="currentColor" stroke-width="1.6" viewBox="0 0 24 24" width="16"><path d="M5 12h13M13 6l6 6-6 6"></path></svg></span>
</a>
</div>
</div>

<div class="hero__panel" data-panel="1">
<p data-cms="t007-الشراكات" class="eyebrow eyebrow--light" data-ar="الشراكات">Partnerships</p>
<h2 data-cms="t008-الجهات-الحكومية-والبحثية-و" class="h-display" data-ar="الجهات الحكومية والبحثية والقطاع الخاص — تحالف واحد.">Government, research and industry — working as one alliance.</h2>
<div class="hero__actions">
<a class="cta-circle cta-circle--light" href={`/${locale}/members`}>
<span data-cms="t009-تعرّف-على-المتحالفين" data-ar="تعرّف على المتحالفين">Meet the members</span>
<span class="circ"><svg fill="none" height="16" stroke="currentColor" stroke-width="1.6" viewBox="0 0 24 24" width="16"><path d="M5 12h13M13 6l6 6-6 6"></path></svg></span>
</a>
</div>
</div>

<div class="hero__panel" data-panel="2">
<p data-cms="t010-الإعلانات" class="eyebrow eyebrow--light" data-ar="الإعلانات">Announcements</p>
<h2 data-cms="t011-التحالف-يفتح-باب-العضوية-ف" class="h-display" data-ar="التحالف يفتح باب العضوية في مجموعات عمله للجهات المهتمة بتقنيات الزراعة والغذاء.">SAFTA is opening working-group membership to organizations across the agrifood technology sector.</h2>
<div class="hero__actions">
<a class="cta-circle cta-circle--light" href={`/${locale}/media`}>
<span data-cms="t012-سجّل-اهتمامك" data-ar="اعرف المزيد">Learn more</span>
<span class="circ"><svg fill="none" height="16" stroke="currentColor" stroke-width="1.6" viewBox="0 0 24 24" width="16"><path d="M5 12h13M13 6l6 6-6 6"></path></svg></span>
</a>
</div>
</div>

</div>
</div>

<div class="hero__tabs">
<div class="wrap">
<button class="hero-tab is-active" data-tab="0" type="button"><span data-cms="t013-رؤى-سافتا" data-ar="رؤى سافتا">SAFTA Insights</span><i></i></button>
<button class="hero-tab" data-tab="1" type="button"><span data-cms="t014-الشراكات" data-ar="الشراكات">Partnerships</span><i></i></button>
<button class="hero-tab" data-tab="2" type="button"><span data-cms="t015-الإعلانات" data-ar="الإعلانات">Announcements</span><i></i></button>
</div>
</div>
</section>
<!-- =============== 2. DISCOVER SAFTA =============== -->
<section class="ribbon ribbon--grey discover">
<div class="wrap">
<div class="discover__intro reveal">
<p data-cms="t016-تعرّف-على-التحالف" class="eyebrow" data-ar="تعرّف على التحالف">Discover SAFTA</p>
<h2 data-cms="t017-نحن-التحالف-الوطني-السعودي" class="h-intro" data-ar="نحن التحالف الوطني السعودي لتقنيات الزراعة والغذاء — نجمع الجهات الحكومية والمؤسسات البحثية والقطاع الخاص لتعزيز الأمن الغذائي.">We are Saudi Arabia’s national alliance for agrifood technology — bringing together government entities, research institutions and the private sector to strengthen food security.</h2>
</div>
<div class="card-row bleed reveal" style="margin-top:66px">
<a class="tile" href={`/${locale}/technologies`}>
<img data-cms-img="i018-kaust1thumb" alt="Open raceway ponds for algae cultivation at KAUST" src="assets/img/gallery/kaust-1-thumb.jpg"/>
<div class="tile__txt">
<p data-cms="t019-مجموعات-العمل" class="eyebrow eyebrow--light" data-ar="مجموعات العمل">Working groups</p>
<h3 data-cms="t020-9-مجموعات-عمل-تعالج-تحديات" data-ar="9 مجموعات عمل تعالج تحديات الزراعة والغذاء في المملكة">9 working groups tackling the Kingdom’s agrifood challenges</h3>
</div>
<span class="tile__arrow"><svg fill="none" height="14" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" width="14"><path d="M5 12h13M13 6l6 6-6 6"></path></svg></span>
</a>
<a class="tile" href={`/${locale}/about`}>
<img data-cms-img="i021-kaust4thumb" alt="What we do" src="assets/img/gallery/kaust-4-thumb.jpg"/>
<div class="tile__txt">
<p data-cms="t022-ما-نقوم-به" class="eyebrow eyebrow--light" data-ar="ما نقوم به">What we do</p>
<h3 data-cms="t023-من-الري-الذكي-إلى-خفض-الفا" data-ar="من الري الذكي إلى خفض الفاقد الغذائي — الابتكار هو المفتاح">From smart irrigation to food-loss reduction, innovation is key</h3>
</div>
<span class="tile__arrow"><svg fill="none" height="14" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" width="14"><path d="M5 12h13M13 6l6 6-6 6"></path></svg></span>
</a>


</div>
</div>
</section>
<!-- =============== 3. CHALLENGES =============== -->
<section class="ribbon believe challenges" id="challenges">
<div class="wrap">
<div class="believe__intro reveal">
<p data-cms="t024-التحديات" class="eyebrow" data-ar="التحديات">Challenges</p>
<h2 data-cms="t025-خمسة-تحديات-وطنية-تُوجّه-ع" class="h-intro" data-ar="يواجه قطاع الزراعة والغذاء مجموعة من التحديات المترابطة التي تؤثّر في الإنتاجية والاستدامة والأمن الغذائي والمرونة الاقتصادية.">The agrifood sector is facing a range of interconnected challenges that are affecting productivity, sustainability, food security, and economic resilience.</h2>
<div class="slider-nav" id="believeNav">
<button aria-label="Previous" class="slider-nav__btn" data-dir="prev" type="button"><svg fill="none" height="16" stroke="currentColor" stroke-width="1.7" viewBox="0 0 24 24" width="16"><path d="M19 12H6M13 6l-6 6 6 6"></path></svg></button>
<button aria-label="Next" class="slider-nav__btn" data-dir="next" type="button"><svg fill="none" height="16" stroke="currentColor" stroke-width="1.7" viewBox="0 0 24 24" width="16"><path d="M5 12h13M13 6l6 6-6 6"></path></svg></button>
</div>
</div>
<div class="slider bleed reveal" id="believeSlider" role="group" style="margin-top:64px" tabindex="0">
<div class="slider__track">
<article class="slide">
<figure><img data-cms-img="i026-phwaterscarcity" alt="Water scarcity" src="assets/img/placeholders/ph-water-scarcity.svg"/></figure>
<h4 data-cms="t027-شُح-الموارد-المائية" data-ar="شُح الموارد المائية">Water scarcity</h4>
</article>
<article class="slide">
<figure><img data-cms-img="i029-phclimate" alt="Harsh climate conditions" src="assets/img/placeholders/ph-climate.svg"/></figure>
<h4 data-cms="t030-قسوة-الظروف-المناخية" data-ar="قسوة الظروف المناخية">Harsh climate conditions</h4>
</article>
<article class="slide">
<figure><img data-cms-img="i032-phpests" alt="Pest risks" src="assets/img/placeholders/ph-pests.svg"/></figure>
<h4 data-cms="t033-مخاطر-الآفات-الزراعية" data-ar="مخاطر الآفات الزراعية">Pest risks</h4>
</article>
<article class="slide">
<figure><img data-cms-img="i035-phsoil" alt="Soil degradation" src="assets/img/placeholders/ph-soil.svg"/></figure>
<h4 data-cms="t036-تدهور-التربة" data-ar="تدهور التربة">Soil degradation</h4>
</article>
<article class="slide">
<figure><img data-cms-img="i038-phfoodwaste" alt="Food waste" src="assets/img/placeholders/ph-food-waste.svg"/></figure>
<h4 data-cms="t039-هدر-الغذاء" data-ar="هدر الغذاء">Food waste</h4>
</article>
<article class="slide">
<figure><img data-cms-img="i061-phimportdependency" alt="Import dependency and food security exposure" src="assets/img/placeholders/ph-what-we-do.svg"/></figure>
<h4 data-cms="t062-الاعتماد-على-الاستيراد" data-ar="الاعتماد على الاستيراد وانكشاف الأمن الغذائي">Import dependency and food security exposure</h4>
</article>
<article class="slide">
<figure><img data-cms-img="i063-phtechgaps" alt="Technology and extension gaps" src="assets/img/placeholders/ph-insight-01.svg"/></figure>
<h4 data-cms="t064-فجوات-التقنية-والإرشاد" data-ar="فجوات التقنية والإرشاد الزراعي">Technology and extension gaps</h4>
</article>
</div>
</div>
<div class="scrollbar" id="believeBar"><i></i></div>
</div>
</section>
<!-- =============== 9b. SAFTA EXCELLENCE AWARDS =============== -->
<section class="ribbon awards" id="awards">
<div class="wrap">
<div class="awards__panel reveal">
<div class="awards__head">
<span class="soon-pill" role="status"><i class="soon-pill__dot" aria-hidden="true"></i><span data-cms="t041-قريبًا" data-ar="قريبًا">Launching Soon</span></span>
<p data-cms="t045-التميّز" class="eyebrow eyebrow--light" data-ar="التميّز">Excellence</p>
<h2 data-cms="t046-جوائز-سافتا-للتميّز" class="h-section" data-ar="جوائز سافتا للتميّز">SAFTA Excellence Awards</h2>
<p data-cms="t047-جائزة-سنوية-تكرّم-الجهات-و" class="lede" data-ar="جائزة سنوية تكرّم الجهات والفرق التي حقّقت أثرًا ملموسًا في تقنيات الزراعة والغذاء بالمملكة — يرشّحها الأعضاء وتقيّمها لجنة تحكيم مستقلة.">An annual award recognising the entities and teams delivering measurable impact in the Kingdom’s agrifood technology — nominated by members and assessed by an independent panel.</p>
<a class="btn-brand" href={`/${locale}/register-interest`}>
<span data-cms="t048-سجّل-اهتمامك-بالترشّح" data-ar="سجّل اهتمامك بالترشّح">Register your interest to nominate</span>
<svg fill="none" height="15" stroke="currentColor" stroke-width="1.9" viewBox="0 0 24 24" width="15"><path d="M5 12h13M13 6l6 6-6 6"></path></svg>
</a>
</div>
<!-- TODO(محتوى): أكّد فئات الجائزة ومواعيد الترشيح مع الأمانة قبل النشر -->
<ol class="awards__cats">
<li class="award">
<span class="award__no" aria-hidden="true">01</span>
<h3 data-cms="t049-ابتكار-العام" data-ar="ابتكار العام">Innovation of the Year</h3>
<p data-cms="t050-حل-تقني-أثبت-أثره-في-الإنت" data-ar="حل تقني أثبت أثره في الإنتاجية أو كفاءة الموارد.">A technology solution with proven impact on productivity or resource efficiency.</p>
<i class="award__rule"></i>
</li>
<li class="award">
<span class="award__no" aria-hidden="true">02</span>
<h3 data-cms="t051-كفاءة-الموارد-المائية" data-ar="كفاءة الموارد المائية">Water Stewardship</h3>
<p data-cms="t052-أفضل-خفض-موثّق-في-استهلاك-" data-ar="أفضل خفض موثّق في استهلاك مياه الري.">The best documented reduction in irrigation water use.</p>
<i class="award__rule"></i>
</li>
<li class="award">
<span class="award__no" aria-hidden="true">03</span>
<h3 data-cms="t053-مجموعة-العمل-المتميزة" data-ar="مجموعة العمل المتميزة">Working Group of the Year</h3>
<p data-cms="t054-المجموعة-الأعلى-إنتاجية-في" data-ar="المجموعة الأعلى إنتاجية في مخرجاتها البحثية والتطبيقية.">The group with the strongest research and applied output.</p>
<i class="award__rule"></i>
</li>
<li class="award">
<span class="award__no" aria-hidden="true">04</span>
<h3 data-cms="t055-الشركة-الناشئة-الواعدة" data-ar="الشركة الناشئة الواعدة">Emerging AgriFood Startup</h3>
<p data-cms="t056-شركة-ناشئة-سعودية-ذات-حل-ق" data-ar="شركة ناشئة سعودية ذات حل قابل للتوسّع.">A Saudi startup with a scalable solution.</p>
<i class="award__rule"></i>
</li>
<li class="award">
<span class="award__no" aria-hidden="true">05</span>
<h3 data-cms="t057-أثر-الكوادر-الوطنية" data-ar="أثر الكوادر الوطنية">National Talent Impact</h3>
<p data-cms="t058-برنامج-بنى-قدرات-وطنية-في-" data-ar="برنامج بنى قدرات وطنية في القطاع.">A programme that built national capability in the sector.</p>
<i class="award__rule"></i>
</li>
</ol>
</div>
</div>
</section>
</main>
<!-- =============== 1b. PARTNER LOGO STRIP =============== -->
<!-- شعارات رسمية مستخرجة من أوراق سياسات التحالف الرسمية
     (المواجز التنفيذية العربية · نوفمبر 2025). المصدر ملف صادر عن
     التحالف نفسه، فالاستخدام هنا مبرَّر. الترتيب أبجدي لا تفضيلي. -->
<section class="partners" aria-label="Alliance partners">
<div class="wrap">
<p class="partners__label" data-ar="الشراكات الاستراتيجية">Strategic partnerships</p>
<div class="partners__viewport">
<div class="partners__track">
<a class="partner" href={`/${locale}/members`} title="Ministry of Environment, Water &amp; Agriculture"><img alt="Ministry of Environment, Water &amp; Agriculture" loading="lazy" src="assets/img/partners/mewa.png"/></a>
<a class="partner" href={`/${locale}/members`} title="King Abdullah University of Science &amp; Technology"><img alt="King Abdullah University of Science &amp; Technology" loading="lazy" src="assets/img/partners/kaust.png"/></a>
<a class="partner" href={`/${locale}/members`} title="National Research &amp; Development Center for Sustainable Agriculture (Estidamah)"><img alt="National Research &amp; Development Center for Sustainable Agriculture" loading="lazy" src="assets/img/partners/estidamah.png"/></a>
<a class="partner" href={`/${locale}/members`} title="ARASCO"><img alt="ARASCO" loading="lazy" src="assets/img/partners/arasco.png"/></a>
<a class="partner" href={`/${locale}/members`} title="Almarai"><img alt="Almarai" loading="lazy" src="assets/img/partners/almarai.png"/></a>
<a class="partner" href={`/${locale}/members`} title="Tanmiah Food Group"><img alt="Tanmiah Food Group" loading="lazy" src="assets/img/partners/tanmiah.png"/></a>
<a class="partner" href={`/${locale}/members`} title="NPRAS — National Platform of R&amp;I Analytics for Sustainability"><img alt="NPRAS — National Platform of R&amp;I Analytics for Sustainability" loading="lazy" src="assets/img/partners/npras.png"/></a>
</div>
</div>
<p class="partners__note" data-ar="الجهات الشريكة استراتيجيًا في تأسيس التحالف وتفعيل مجموعات عمله.">The strategic partners behind the Alliance's establishment and the activation of its working groups.</p>
</div>
</section>
<script slot="scripts" is:inline src="assets/content/index.js?v=28"></script>
<script slot="scripts" is:inline src="assets/js/cms.js?v=28"></script>
</BaseLayout>
