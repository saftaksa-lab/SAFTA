---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Text from '../../components/content/Text.astro';
import Image from '../../components/content/Image.astro';
import { getPageContent } from '../../lib/content/store';
import { INDEX_FIELDS } from '../../lib/content/schema/index';
import { isLocale } from '../../lib/locale';

export function getStaticPaths() {
  return [{ params: { locale: 'en' } }, { params: { locale: 'ar' } }];
}
const { locale } = Astro.params;
if (!isLocale(locale)) return new Response(null, { status: 404 });

const c = await getPageContent<typeof INDEX_FIELDS>('index');
---
<BaseLayout
  locale={locale}
  title="Where technology feeds the future | SAFTA"
  titleAr="حيث تُغذّي التقنية المستقبل | التحالف السعودي لتقنيات الزراعة والغذاء"
  description="SAFTA — the Saudi AgriFood Tech Alliance. A national platform accelerating agrifood technology adoption across the Kingdom."
  current="index"
  appleTouchIcon
>
<main>
<!-- =============== 1. HERO CAROUSEL =============== -->
<section class="hero" id="hero">
<div class="hero__stage">

<div class="hero__slide is-active" data-slide="0">
<Image key="i001-gd02bedshero" field={c.image("i001-gd02bedshero")} />
</div>
<div class="hero__slide" data-slide="1">
<Image key="i002-gd03rowshero" field={c.image("i002-gd03rowshero")} />
</div>
<div class="hero__slide" data-slide="2">
<Image key="i003-gd09rackshero" field={c.image("i003-gd09rackshero")} />
</div>

<div class="hero__scrim"></div>

<div class="wrap hero__copy">

<div class="hero__panel is-active" data-panel="0">
<Text as="p" key="t004-رؤى-سافتا" field={c.text("t004-رؤى-سافتا")} class="eyebrow eyebrow--light" />
<Text as="h1" key="t005-معرفة-تطبيقية-تدعم-قرارات-" field={c.text("t005-معرفة-تطبيقية-تدعم-قرارات-")} class="h-display" />
<div class="hero__actions">
<a class="cta-circle cta-circle--light" href={`/${locale}/about`}>
<Text as="span" key="t006-استعرض-الرؤى" field={c.text("t006-استعرض-الرؤى")} />
<span class="circ"><svg fill="none" height="16" stroke="currentColor" stroke-width="1.6" viewBox="0 0 24 24" width="16"><path d="M5 12h13M13 6l6 6-6 6"></path></svg></span>
</a>
</div>
</div>

<div class="hero__panel" data-panel="1">
<Text as="p" key="t007-الشراكات" field={c.text("t007-الشراكات")} class="eyebrow eyebrow--light" />
<Text as="h2" key="t008-الجهات-الحكومية-والبحثية-و" field={c.text("t008-الجهات-الحكومية-والبحثية-و")} class="h-display" />
<div class="hero__actions">
<a class="cta-circle cta-circle--light" href={`/${locale}/members`}>
<Text as="span" key="t009-تعرّف-على-المتحالفين" field={c.text("t009-تعرّف-على-المتحالفين")} />
<span class="circ"><svg fill="none" height="16" stroke="currentColor" stroke-width="1.6" viewBox="0 0 24 24" width="16"><path d="M5 12h13M13 6l6 6-6 6"></path></svg></span>
</a>
</div>
</div>

<div class="hero__panel" data-panel="2">
<Text as="p" key="t010-الإعلانات" field={c.text("t010-الإعلانات")} class="eyebrow eyebrow--light" />
<Text as="h2" key="t011-التحالف-يفتح-باب-العضوية-ف" field={c.text("t011-التحالف-يفتح-باب-العضوية-ف")} class="h-display" />
<div class="hero__actions">
<a class="cta-circle cta-circle--light" href={`/${locale}/media`}>
<Text as="span" key="t012-سجّل-اهتمامك" field={c.text("t012-سجّل-اهتمامك")} />
<span class="circ"><svg fill="none" height="16" stroke="currentColor" stroke-width="1.6" viewBox="0 0 24 24" width="16"><path d="M5 12h13M13 6l6 6-6 6"></path></svg></span>
</a>
</div>
</div>

</div>
</div>

<div class="hero__tabs">
<div class="wrap">
<button class="hero-tab is-active" data-tab="0" type="button"><Text as="span" key="t013-رؤى-سافتا" field={c.text("t013-رؤى-سافتا")} /><i></i></button>
<button class="hero-tab" data-tab="1" type="button"><Text as="span" key="t014-الشراكات" field={c.text("t014-الشراكات")} /><i></i></button>
<button class="hero-tab" data-tab="2" type="button"><Text as="span" key="t015-الإعلانات" field={c.text("t015-الإعلانات")} /><i></i></button>
</div>
</div>
</section>
<!-- =============== 2. DISCOVER SAFTA =============== -->
<section class="ribbon ribbon--grey discover">
<div class="wrap">
<div class="discover__intro reveal">
<Text as="p" key="t016-تعرّف-على-التحالف" field={c.text("t016-تعرّف-على-التحالف")} class="eyebrow" />
<Text as="h2" key="t017-نحن-التحالف-الوطني-السعودي" field={c.text("t017-نحن-التحالف-الوطني-السعودي")} class="h-intro" />
</div>
<div class="card-row bleed reveal" style="margin-top:66px">
<a class="tile" href={`/${locale}/technologies`}>
<Image key="i018-kaust1thumb" field={c.image("i018-kaust1thumb")} />
<div class="tile__txt">
<Text as="p" key="t019-مجموعات-العمل" field={c.text("t019-مجموعات-العمل")} class="eyebrow eyebrow--light" />
<Text as="h3" key="t020-9-مجموعات-عمل-تعالج-تحديات" field={c.text("t020-9-مجموعات-عمل-تعالج-تحديات")} />
</div>
<span class="tile__arrow"><svg fill="none" height="14" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" width="14"><path d="M5 12h13M13 6l6 6-6 6"></path></svg></span>
</a>
<a class="tile" href={`/${locale}/about`}>
<Image key="i021-kaust4thumb" field={c.image("i021-kaust4thumb")} />
<div class="tile__txt">
<Text as="p" key="t022-ما-نقوم-به" field={c.text("t022-ما-نقوم-به")} class="eyebrow eyebrow--light" />
<Text as="h3" key="t023-من-الري-الذكي-إلى-خفض-الفا" field={c.text("t023-من-الري-الذكي-إلى-خفض-الفا")} />
</div>
<span class="tile__arrow"><svg fill="none" height="14" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" width="14"><path d="M5 12h13M13 6l6 6-6 6"></path></svg></span>
</a>


</div>
</div>
</section>
<!-- =============== 3. CHALLENGES =============== -->
<section class="ribbon believe challenges" id="challenges">
<div class="wrap">
<div class="believe__intro reveal">
<Text as="p" key="t024-التحديات" field={c.text("t024-التحديات")} class="eyebrow" />
<Text as="h2" key="t025-خمسة-تحديات-وطنية-تُوجّه-ع" field={c.text("t025-خمسة-تحديات-وطنية-تُوجّه-ع")} class="h-intro" />
<div class="slider-nav" id="believeNav">
<button aria-label="Previous" class="slider-nav__btn" data-dir="prev" type="button"><svg fill="none" height="16" stroke="currentColor" stroke-width="1.7" viewBox="0 0 24 24" width="16"><path d="M19 12H6M13 6l-6 6 6 6"></path></svg></button>
<button aria-label="Next" class="slider-nav__btn" data-dir="next" type="button"><svg fill="none" height="16" stroke="currentColor" stroke-width="1.7" viewBox="0 0 24 24" width="16"><path d="M5 12h13M13 6l6 6-6 6"></path></svg></button>
</div>
</div>
<div class="slider bleed reveal" id="believeSlider" role="group" style="margin-top:64px" tabindex="0">
<div class="slider__track">
<article class="slide">
<figure><Image key="i026-phwaterscarcity" field={c.image("i026-phwaterscarcity")} /></figure>
<Text as="h4" key="t027-شُح-الموارد-المائية" field={c.text("t027-شُح-الموارد-المائية")} />
</article>
<article class="slide">
<figure><Image key="i029-phclimate" field={c.image("i029-phclimate")} /></figure>
<Text as="h4" key="t030-قسوة-الظروف-المناخية" field={c.text("t030-قسوة-الظروف-المناخية")} />
</article>
<article class="slide">
<figure><Image key="i032-phpests" field={c.image("i032-phpests")} /></figure>
<Text as="h4" key="t033-مخاطر-الآفات-الزراعية" field={c.text("t033-مخاطر-الآفات-الزراعية")} />
</article>
<article class="slide">
<figure><Image key="i035-phsoil" field={c.image("i035-phsoil")} /></figure>
<Text as="h4" key="t036-تدهور-التربة" field={c.text("t036-تدهور-التربة")} />
</article>
<article class="slide">
<figure><Image key="i038-phfoodwaste" field={c.image("i038-phfoodwaste")} /></figure>
<Text as="h4" key="t039-هدر-الغذاء" field={c.text("t039-هدر-الغذاء")} />
</article>
<article class="slide">
<figure><Image key="i061-phimportdependency" field={c.image("i061-phimportdependency")} /></figure>
<Text as="h4" key="t062-الاعتماد-على-الاستيراد" field={c.text("t062-الاعتماد-على-الاستيراد")} />
</article>
<article class="slide">
<figure><Image key="i063-phtechgaps" field={c.image("i063-phtechgaps")} /></figure>
<Text as="h4" key="t064-فجوات-التقنية-والإرشاد" field={c.text("t064-فجوات-التقنية-والإرشاد")} />
</article>
</div>
</div>
<div class="scrollbar" id="believeBar"><i></i></div>
</div>
</section>
<!-- =============== 9b. SAFTA EXCELLENCE AWARDS =============== -->
<section class="ribbon awards" id="awards">
<div class="wrap">
<div class="awards__panel reveal">
<div class="awards__head">
<span class="soon-pill" role="status"><i class="soon-pill__dot" aria-hidden="true"></i><Text as="span" key="t041-قريبًا" field={c.text("t041-قريبًا")} /></span>
<Text as="p" key="t045-التميّز" field={c.text("t045-التميّز")} class="eyebrow eyebrow--light" />
<Text as="h2" key="t046-جوائز-سافتا-للتميّز" field={c.text("t046-جوائز-سافتا-للتميّز")} class="h-section" />
<Text as="p" key="t047-جائزة-سنوية-تكرّم-الجهات-و" field={c.text("t047-جائزة-سنوية-تكرّم-الجهات-و")} class="lede" />
<a class="btn-brand" href={`/${locale}/register-interest`}>
<Text as="span" key="t048-سجّل-اهتمامك-بالترشّح" field={c.text("t048-سجّل-اهتمامك-بالترشّح")} />
<svg fill="none" height="15" stroke="currentColor" stroke-width="1.9" viewBox="0 0 24 24" width="15"><path d="M5 12h13M13 6l6 6-6 6"></path></svg>
</a>
</div>
<!-- TODO(محتوى): أكّد فئات الجائزة ومواعيد الترشيح مع الأمانة قبل النشر -->
<ol class="awards__cats">
<li class="award">
<span class="award__no" aria-hidden="true">01</span>
<Text as="h3" key="t049-ابتكار-العام" field={c.text("t049-ابتكار-العام")} />
<Text as="p" key="t050-حل-تقني-أثبت-أثره-في-الإنت" field={c.text("t050-حل-تقني-أثبت-أثره-في-الإنت")} />
<i class="award__rule"></i>
</li>
<li class="award">
<span class="award__no" aria-hidden="true">02</span>
<Text as="h3" key="t051-كفاءة-الموارد-المائية" field={c.text("t051-كفاءة-الموارد-المائية")} />
<Text as="p" key="t052-أفضل-خفض-موثّق-في-استهلاك-" field={c.text("t052-أفضل-خفض-موثّق-في-استهلاك-")} />
<i class="award__rule"></i>
</li>
<li class="award">
<span class="award__no" aria-hidden="true">03</span>
<Text as="h3" key="t053-مجموعة-العمل-المتميزة" field={c.text("t053-مجموعة-العمل-المتميزة")} />
<Text as="p" key="t054-المجموعة-الأعلى-إنتاجية-في" field={c.text("t054-المجموعة-الأعلى-إنتاجية-في")} />
<i class="award__rule"></i>
</li>
<li class="award">
<span class="award__no" aria-hidden="true">04</span>
<Text as="h3" key="t055-الشركة-الناشئة-الواعدة" field={c.text("t055-الشركة-الناشئة-الواعدة")} />
<Text as="p" key="t056-شركة-ناشئة-سعودية-ذات-حل-ق" field={c.text("t056-شركة-ناشئة-سعودية-ذات-حل-ق")} />
<i class="award__rule"></i>
</li>
<li class="award">
<span class="award__no" aria-hidden="true">05</span>
<Text as="h3" key="t057-أثر-الكوادر-الوطنية" field={c.text("t057-أثر-الكوادر-الوطنية")} />
<Text as="p" key="t058-برنامج-بنى-قدرات-وطنية-في-" field={c.text("t058-برنامج-بنى-قدرات-وطنية-في-")} />
<i class="award__rule"></i>
</li>
</ol>
</div>
</div>
</section>
</main>
<!-- =============== 1b. PARTNER LOGO STRIP =============== -->
<!-- شعارات رسمية مستخرجة من أوراق سياسات التحالف الرسمية
     (المواجز التنفيذية العربية · نوفمبر 2025). المصدر ملف صادر عن
     التحالف نفسه، فالاستخدام هنا مبرَّر. الترتيب أبجدي لا تفضيلي. -->
<section class="partners" aria-label="Alliance partners">
<div class="wrap">
<p class="partners__label" data-ar="الشراكات الاستراتيجية">Strategic partnerships</p>
<div class="partners__viewport">
<div class="partners__track">
<a class="partner" href={`/${locale}/members`} title="Ministry of Environment, Water &amp; Agriculture"><img alt="Ministry of Environment, Water &amp; Agriculture" loading="lazy" src="assets/img/partners/mewa.png"/></a>
<a class="partner" href={`/${locale}/members`} title="King Abdullah University of Science &amp; Technology"><img alt="King Abdullah University of Science &amp; Technology" loading="lazy" src="assets/img/partners/kaust.png"/></a>
<a class="partner" href={`/${locale}/members`} title="National Research &amp; Development Center for Sustainable Agriculture (Estidamah)"><img alt="National Research &amp; Development Center for Sustainable Agriculture" loading="lazy" src="assets/img/partners/estidamah.png"/></a>
<a class="partner" href={`/${locale}/members`} title="ARASCO"><img alt="ARASCO" loading="lazy" src="assets/img/partners/arasco.png"/></a>
<a class="partner" href={`/${locale}/members`} title="Almarai"><img alt="Almarai" loading="lazy" src="assets/img/partners/almarai.png"/></a>
<a class="partner" href={`/${locale}/members`} title="Tanmiah Food Group"><img alt="Tanmiah Food Group" loading="lazy" src="assets/img/partners/tanmiah.png"/></a>
<a class="partner" href={`/${locale}/members`} title="NPRAS — National Platform of R&amp;I Analytics for Sustainability"><img alt="NPRAS — National Platform of R&amp;I Analytics for Sustainability" loading="lazy" src="assets/img/partners/npras.png"/></a>
</div>
</div>
<p class="partners__note" data-ar="الجهات الشريكة استراتيجيًا في تأسيس التحالف وتفعيل مجموعات عمله.">The strategic partners behind the Alliance's establishment and the activation of its working groups.</p>
</div>
</section>
</BaseLayout>
