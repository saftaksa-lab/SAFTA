---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Text from '../../components/content/Text.astro';
import { getPageContent } from '../../lib/content/store';
import { getCollectionContent } from '../../lib/content/collections/store';
import { MEMBERS_FIELDS as MEMBERS_PAGE_FIELDS } from '../../lib/content/schema/members';
import { MEMBERS_FIELDS } from '../../lib/content/collections/members';
import { isLocale } from '../../lib/locale';

export function getStaticPaths() {
  return [{ params: { locale: 'en' } }, { params: { locale: 'ar' } }];
}
const { locale } = Astro.params;
if (!isLocale(locale)) return new Response(null, { status: 404 });

// Hero copy comes from content/members-page.json (this page's own schema module, not the
// _members collection below — see schema/members.ts for why it has a distinct file name).
const c = await getPageContent<typeof MEMBERS_PAGE_FIELDS>('members');

const members = await getCollectionContent<typeof MEMBERS_FIELDS>('members');
const items = members.items().map((m) => ({
  id: m.id,
  name: m.text('name'),
  logo: m.image('logo'),
}));
---
<BaseLayout
  locale={locale}
  title="Members | SAFTA"
  titleAr="الأعضاء | التحالف السعودي"
  description="Government, academic, private sector and non-profit entities working together on agrifood technology."
  current="members"
>
<link slot="head" crossorigin="" href="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.css" integrity="sha512-h9FcoyWjHcOcmEVkxOfTLnmZFWIH0iZhZT1H2TbOq55xssQGEJHEaIm+PgoUaZbRvQTNTluNOEfb1ZRy6D3BOw==" referrerpolicy="no-referrer" rel="stylesheet"/>
<main>
<section class="page-hero page-hero--plain">
<div class="wrap">
<p class="crumbs"><Text as="a" key="t001-الرئيسية" field={c.text("t001-الرئيسية")} href={`/${locale}`} /><span>/</span>Members</p>
<Text as="h1" key="t002-الأعضاء" field={c.text("t002-الأعضاء")} />
<Text as="p" key="t003-جهات-حكومية-وأكاديمية-ومن-" field={c.text("t003-جهات-حكومية-وأكاديمية-ومن-")} class="lede" />
</div>
</section>
<section class="ribbon">
<div class="wrap">
<div class="sec-head reveal">
<div class="sec-head__txt">
<Text as="p" key="t004-التحالف" field={c.text("t004-التحالف")} class="eyebrow" />
<Text as="h2" key="t005-الأعضاء" field={c.text("t005-الأعضاء")} class="h-section" />
<Text as="p" key="t006-جهات-حكومية-ومؤسسات-أكاديم" field={c.text("t006-جهات-حكومية-ومؤسسات-أكاديم")} class="lede" />
</div>
</div>
<div class="grid-3" id="memberGrid">
{items.map((m, i) => (
  <a class={`mcard member-card member-card--${'abcdef'[i % 6]} reveal`} href={`/${locale}/member?id=${m.id}`}>
    <span class="member-card__logo"><img alt="" loading="lazy" src={m.logo.src} /></span>
    <h3 data-ar={m.name.ar || m.name.en}>{m.name.en || m.name.ar}</h3>
  </a>
))}
</div>
</div>
</section>
</main>
<script slot="scripts" is:inline crossorigin="" integrity="sha512-BwHfrr4c9kmRkLw6iXFdzcdWV/PGkVgiIyIWLLlTSXzWQzxuSg4DiQUCpauz/EWjgk5TYQqX/kvn9pG1NpYfqg==" referrerpolicy="no-referrer" src="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.js"></script>
<script slot="scripts" is:inline src="assets/js/members-map-data.js"></script>
</BaseLayout>
