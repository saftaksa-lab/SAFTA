---
import BaseLayout from '../../layouts/BaseLayout.astro';

export function getStaticPaths() {
  return [{ params: { locale: 'en' } }, { params: { locale: 'ar' } }];
}
const { locale } = Astro.params;
---
<BaseLayout
  locale={locale}
  title="Reset password | SAFTA"
  titleAr="استعادة كلمة المرور | التحالف السعودي"
>
<main>
<section class="page-hero page-hero--slim">
<div class="wrap">
<p class="crumbs"><a data-ar="الرئيسية" href={`/${locale}`}>Home</a><span>/</span><a data-ar="تسجيل الدخول" href={`/${locale}/login`}>Login</a><span>/</span><span data-ar="استعادة كلمة المرور">Reset password</span></p>
<h1 data-ar="استعادة كلمة المرور">Reset your password</h1>
<p class="lede" data-ar="أدخل بريدك الإلكتروني المسجّل، وسنرسل لك رابطًا لإعادة تعيين كلمة المرور.">Enter your registered email address and we will send you a link to reset your password.</p>
</div>
</section>

<section class="ribbon">
<div class="wrap">
<div class="auth-card reveal">
<form class="form" id="resetForm" novalidate="">
<div class="field">
<label data-ar="البريد الإلكتروني" for="r-email">Email address <b class="req">*</b></label>
<input autocomplete="email" id="r-email" name="email" required="" type="email"/>
</div>
<div class="form-actions">
<button class="btn-solid" type="submit"><span data-ar="إرسال الرابط">Send reset link</span><svg fill="none" height="16" stroke="currentColor" stroke-width="1.6" viewBox="0 0 24 24" width="16"><path d="M5 12h13M13 6l6 6-6 6"></path></svg></button>
<span class="form-msg" id="rMsg"><svg fill="none" height="18" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" width="18"><path d="M20 6L9 17l-5-5"></path></svg><span data-ar="إن كان البريد مسجّلًا لدينا، فستصلك رسالة خلال دقائق.">If that address is registered with us, you will receive an email within a few minutes.</span></span>
</div>
</form>
<p class="auth-alt"><a data-ar="العودة إلى تسجيل الدخول" href={`/${locale}/login`}>Back to login</a><span>·</span><a data-ar="تواصل مع الأمانة" href={`/${locale}/contact`}>Contact the Secretariat</a></p>
</div>
</div>
</section>
</main>
</BaseLayout>
