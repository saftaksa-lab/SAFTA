---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Text from '../../components/content/Text.astro';
import { getMember, getSingleton } from '../../lib/content/cache';
import { english, pick } from '../../lib/bilingual';
import { uploadedImage } from '../../lib/safta-assets';
import { crumbHome, memberCategoryLabels } from '../../lib/ui';
import { isLocale } from '../../lib/locale';

export function getStaticPaths() {
  return [{ params: { locale: 'en' } }, { params: { locale: 'ar' } }];
}
const { locale } = Astro.params;
if (!isLocale(locale)) return new Response(null, { status: 404 });

// `?id=` is the member's slug. With none, send the visitor to the directory; an unknown or
// unpublished one is a 404 (it used to show the first member instead).
const id = Astro.url.searchParams.get('id');
if (!id) return Astro.redirect(`/${locale}/members`);
const member = getMember(id);
if (!member) return new Response(null, { status: 404 });

// Breadcrumbs, fact labels and the contact block are the same on every profile.
const chrome = getSingleton('member_chrome');
const name = pick(member, 'name');
const logo = uploadedImage(member.logoId);
---
<BaseLayout
  locale={locale}
  title={`${english(name)} | SAFTA`}
  titleAr={`${name.ar} | التحالف السعودي`}
>
<main>
<section class="page-hero page-hero--plain">
<div class="wrap">
<p class="crumbs"><Text as="a" field={crumbHome} href={`/${locale}`} /><span>/</span><Text as="a" field={pick(chrome, 'crumbMembers')} href={`/${locale}/members`} /><span>/</span>Profile</p>
<Text as="h1" field={pick(chrome, 'title')} />
</div>
</section>
<section class="ribbon">
<div class="wrap">
<div class="member-head reveal">
<span class="member-card__logo" id="mLogo">{logo ? <img src={logo.src} width={logo.width} height={logo.height} alt={english(name)} /> : <span>{member.initials}</span>}</span>
<div>
<Text as="p" class="eyebrow" id="mCat" field={memberCategoryLabels[member.category]} />
<Text as="h2" class="h-section" id="mName" style="margin-top:10px" field={name} />
</div>
</div>
<div class="facts reveal">
<div class="fact"><Text as="b" field={pick(chrome, 'roleLabel')} /><Text as="span" id="mRole" field={pick(member, 'role')} /></div>
<div class="fact"><Text as="b" field={pick(chrome, 'sectorLabel')} /><Text as="span" id="mSector" field={pick(member, 'sector')} /></div>
<div class="fact"><Text as="b" field={pick(chrome, 'sinceLabel')} /><span id="mSince">{member.since}</span></div>
</div>
<div class="prose reveal" style="margin-top:72px">
<Text as="h2" field={pick(chrome, 'overviewHeading')} />
<Text as="p" id="mBio" field={pick(member, 'bio')} />
<Text as="h2" field={pick(chrome, 'collaborationHeading')} />
<ul>
{chrome.collaborationItems.map((item) => (
<Text as="li" field={pick(item, 'text')} />
))}
</ul>
</div>

<div class="mcontact reveal">
<div class="mcontact__txt">
<Text as="p" field={pick(chrome, 'contactEyebrow')} class="eyebrow" />
<Text as="h2" field={pick(chrome, 'contactHeading')} />
<Text as="p" field={pick(chrome, 'contactText')} />
</div>
<div class="mcontact__acts">
<a class="btn-solid" href={`/${locale}/contact`}>
<Text as="span" field={pick(chrome, 'contactCtaLabel')} />
<svg fill="none" height="16" stroke="currentColor" stroke-width="1.6" viewBox="0 0 24 24" width="16"><path d="M5 12h13M13 6l6 6-6 6"></path></svg>
</a>
<a class="mcontact__mail" href={`mailto:${chrome.contactEmail}`}>
<svg fill="none" height="16" stroke="currentColor" stroke-width="1.7" viewBox="0 0 24 24" width="16"><rect height="15" rx="2.5" width="19" x="2.5" y="4.5"></rect><path d="M3 6.5l9 6.5 9-6.5"></path></svg>
<span>{chrome.contactEmail}</span>
</a>
</div>
</div>
<div style="margin-top:64px">
<a class="cta-circle" href={`/${locale}/members`}><Text as="span" field={pick(chrome, 'backLabel')} /><span class="circ"><svg fill="none" height="16" stroke="currentColor" stroke-width="1.6" viewBox="0 0 24 24" width="16"><path d="M5 12h13M13 6l6 6-6 6"></path></svg></span></a>
</div>
</div>
</section>
</main>
</BaseLayout>
