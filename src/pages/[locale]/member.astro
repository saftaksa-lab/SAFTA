---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Text from '../../components/content/Text.astro';
import Value from '../../components/content/Value.astro';
import Image from '../../components/content/Image.astro';
import { getCollectionContent } from '../../lib/content/collections/store';
import { MEMBERS_FIELDS } from '../../lib/content/collections/members';
import { isLocale } from '../../lib/locale';

export function getStaticPaths() {
  return [{ params: { locale: 'en' } }, { params: { locale: 'ar' } }];
}
const { locale } = Astro.params;
if (!isLocale(locale)) return new Response(null, { status: 404 });

const members = await getCollectionContent<typeof MEMBERS_FIELDS>('members');
const all = members.items();
const id = Astro.url.searchParams.get('id');
// Same fallback the old client-side lookup used: an unknown/missing id shows the first
// record rather than a hard 404.
const member = all.find((m) => m.id === id) ?? all[0];

const name = member.text('name');
const logo = member.image('logo');
const ini = member.value('ini');
const cat = member.text('cat');
const role = member.text('role');
const sector = member.text('sector');
const since = member.value('since');
const bio = member.text('bio');
---
<BaseLayout
  locale={locale}
  title={`${name.en} | SAFTA`}
  titleAr={`${name.ar} | التحالف السعودي`}
>
<main>
<section class="page-hero page-hero--plain">
<div class="wrap">
<p class="crumbs"><a data-cms="t001-الرئيسية" data-ar="الرئيسية" href={`/${locale}`}>Home</a><span>/</span><a data-cms="t002-المتحالفون" data-ar="المتحالفون" href={`/${locale}/members`}>Members</a><span>/</span>Profile</p>
<h1 data-cms="t003-ملف-العضو" data-ar="ملف العضو">Member profile</h1>
</div>
</section>
<section class="ribbon">
<div class="wrap">
<p class="demo-note"><svg fill="none" height="17" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" width="17"><circle cx="12" cy="12" r="9"></circle><path d="M12 8h.01M11 12h1v4h1"></path></svg><span data-cms="t004-بيانات-تجريبية-المدخلات-في" data-ar="&lt;b&gt;بيانات تجريبية.&lt;/b&gt; المدخلات في هذه الصفحة عناصر مبدئية لعرض التصميم فقط، ويجب استبدالها بسجلات التحالف الحقيقية قبل الإطلاق."><b data-ar="بيانات تجريبية.">Demo data.</b> The entries on this page are placeholders used to show the layout. Replace them with the Alliance’s real records before launch.</span></p>
<div class="member-head reveal">
<span class="member-card__logo" id="mLogo">{logo.src ? <Image key="logo" field={{ src: logo.src, alt: name.en, altAr: name.ar }} /> : <Value as="span" key="ini" value={ini} />}</span>
<div>
<Text as="p" class="eyebrow" id="mCat" key="cat" field={cat} />
<Text as="h2" class="h-section" id="mName" style="margin-top:10px" key="name" field={name} />
</div>
</div>
<div class="facts reveal">
<div class="fact"><b data-cms="t007-الدور-في-التحالف" data-ar="الدور في التحالف">Role in the Alliance</b><Text as="span" id="mRole" key="role" field={role} /></div>
<div class="fact"><b data-cms="t009-مجال-التركيز" data-ar="مجال التركيز">Sector focus</b><Text as="span" id="mSector" key="sector" field={sector} /></div>
<div class="fact"><b data-cms="t011-عضو-منذ" data-ar="عضو منذ">Member since</b><Value as="span" id="mSince" key="since" value={since} /></div>
</div>
<div class="prose reveal" style="margin-top:72px">
<h2 data-cms="t012-نبذة" data-ar="نبذة">Overview</h2>
<Text as="p" id="mBio" key="bio" field={bio} />
<h2 data-cms="t013-مجالات-التعاون" data-ar="مجالات التعاون">Areas of collaboration</h2>
<ul>
<li data-cms="t014-التبنّي-المنسّق-لتقنيات-ال" data-ar="التبنّي المنسّق لتقنيات الزراعة والغذاء على مستوى القطاع.">Coordinated adoption of agrifood technologies across the sector.</li>
<li data-cms="t015-التبادل-العلمي-والبحثي-مع-" data-ar="التبادل العلمي والبحثي مع الشركاء المحليين والدوليين.">Scientific and research exchange with national and international partners.</li>
<li data-cms="t016-بناء-القدرات-البشرية-ونقل-" data-ar="بناء القدرات البشرية ونقل المعرفة.">Human capacity building and knowledge transfer.</li>
</ul>
</div>

<div class="mcontact reveal">
<div class="mcontact__txt">
<p data-cms="t017-التواصل" class="eyebrow" data-ar="التواصل">Get in touch</p>
<h2 data-cms="t018-تواصل-مع-هذه-الجهة-عبر-الت" data-ar="تواصل مع هذه الجهة عبر التحالف">Reach this member through the Alliance</h2>
<p data-cms="t019-تُوجَّه-الطلبات-المتعلقة-ب" data-ar="تُوجَّه الطلبات المتعلقة بهذه الجهة عبر أمانة التحالف، فنحيلها إلى جهة الاتصال المناسبة لديها.">Requests relating to this member are routed through the Alliance Secretariat, which forwards them to the right contact point.</p>
</div>
<div class="mcontact__acts">
<a class="btn-solid" href={`/${locale}/contact`}>
<span data-cms="t020-افتح-نموذج-التواصل" data-ar="افتح نموذج التواصل">Open the contact form</span>
<svg fill="none" height="16" stroke="currentColor" stroke-width="1.6" viewBox="0 0 24 24" width="16"><path d="M5 12h13M13 6l6 6-6 6"></path></svg>
</a>
<a class="mcontact__mail" href="mailto:secretariat@safta.sa">
<svg fill="none" height="16" stroke="currentColor" stroke-width="1.7" viewBox="0 0 24 24" width="16"><rect height="15" rx="2.5" width="19" x="2.5" y="4.5"></rect><path d="M3 6.5l9 6.5 9-6.5"></path></svg>
<span>secretariat@safta.sa</span>
</a>
</div>
</div>
<div style="margin-top:64px">
<a class="cta-circle" href={`/${locale}/members`}><span data-cms="t021-العودة-إلى-كل-المتحالفين" data-ar="العودة إلى كل المتحالفين">Back to all members</span><span class="circ"><svg fill="none" height="16" stroke="currentColor" stroke-width="1.6" viewBox="0 0 24 24" width="16"><path d="M5 12h13M13 6l6 6-6 6"></path></svg></span></a>
</div>
</div>
</section>
</main>
<script slot="scripts" is:inline src="assets/content/member.js?v=28"></script>
<script slot="scripts" is:inline src="assets/js/cms.js?v=28"></script>
</BaseLayout>
