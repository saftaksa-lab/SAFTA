---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Text from '../../components/content/Text.astro';
import { getSingleton } from '../../lib/content/cache';
import { english, pick } from '../../lib/bilingual';
import { crumbHome } from '../../lib/ui';
import { isLocale } from '../../lib/locale';

export function getStaticPaths() {
  return [{ params: { locale: 'en' } }, { params: { locale: 'ar' } }];
}
const { locale } = Astro.params;
if (!isLocale(locale)) return new Response(null, { status: 404 });

const hero = getSingleton('register_hero');
const form = getSingleton('register_form');
const info = getSingleton('register_info');
const website = pick(form, 'websitePlaceholder');
---
<BaseLayout
  locale={locale}
  title="Register your interest | SAFTA"
  titleAr="سجّل اهتمامك | التحالف السعودي"
  description="Tell us who you are and which challenge you want to work on. We will follow up with the membership pack."
  joinBanner={false}
>
<main>
<section class="page-hero page-hero--plain">
<div class="wrap">
<p class="crumbs"><Text as="a" field={crumbHome} href={`/${locale}`} /><span>/</span>Register interest</p>
<Text as="h1" field={pick(hero, 'title')} />
<Text as="p" field={pick(hero, 'lede')} class="lede" />
</div>
</section>
<section class="ribbon">
<div class="wrap">
<div class="form-shell">
<form class="form reveal" id="interestForm" novalidate="">
<div class="row-2">
<div class="field"><Text as="label" field={pick(form, 'nameLabel')} for="ri-name" required /><input id="ri-name" name="name" required=""/></div>
<div class="field"><Text as="label" field={pick(form, 'entityLabel')} for="ri-entity" required /><input id="ri-entity" name="entity" required=""/></div>
</div>
<div class="row-2">
<div class="field"><Text as="label" field={pick(form, 'entityTypeLabel')} for="ri-type" required />
<select id="ri-type" name="type" required=""><Text as="option" field={pick(form, 'entityTypePrompt')} value="" />{form.entityTypeOptions.map((option) => (<Text as="option" field={pick(option, 'label')} value={option.value} />))}</select></div>
<div class="field"><Text as="label" field={pick(form, 'emailLabel')} for="ri-email" required /><input id="ri-email" name="email" required="" type="email"/></div>
</div>
<div class="row-2">
<div class="field"><Text as="label" field={pick(form, 'phoneLabel')} for="ri-phone" /><input id="ri-phone" name="phone"/></div>
<div class="field"><Text as="label" field={pick(form, 'websiteLabel')} for="ri-site" /><input data-ar-placeholder={website.ar} id="ri-site" name="website" placeholder={english(website)}/></div>
</div>
<div class="field"><Text as="label" field={pick(form, 'areaLabel')} for="ri-area" required />
<select id="ri-area" name="area" required=""><Text as="option" field={pick(form, 'areaPrompt')} value="" />{form.areaOptions.map((option) => (<Text as="option" field={pick(option, 'label')} value={option.value} />))}</select>
<Text as="p" field={pick(form, 'areaHint')} class="hint" /></div>
<div class="field"><Text as="label" field={pick(form, 'messageLabel')} for="ri-msg" /><textarea id="ri-msg" name="message"></textarea></div>
<div class="field">
<Text as="label" field={pick(form, 'portfolioLabel')} for="ri-file" />
<Text as="p" field={pick(form, 'portfolioHint')} class="hint hint--top" />
<div class="filepick">
<input accept=".pdf,.ppt,.pptx,.doc,.docx" id="ri-file" name="portfolio" type="file"/>
<Text as="label" field={pick(form, 'chooseFileLabel')} class="filepick__btn" for="ri-file" />
<Text as="span" field={pick(form, 'noFileLabel')} class="filepick__name" />
</div>
</div>
<label class="check"><input required="" type="checkbox"/><Text as="span" field={pick(form, 'consent')} prose locale={locale} /></label>
<div class="form-actions">
<button class="btn-solid" type="submit"><Text as="span" field={pick(form, 'submitLabel')} /><svg fill="none" height="16" stroke="currentColor" stroke-width="1.6" viewBox="0 0 24 24" width="16"><path d="M5 12h13M13 6l6 6-6 6"></path></svg></button>
<span class="form-msg" id="riMsg"><svg fill="none" height="15" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" width="15"><path d="M20 6L9 17l-5-5"></path></svg><Text as="span" field={pick(form, 'successMessage')} /></span>
</div>
</form>
<aside class="aside-card reveal">
<Text as="h3" field={pick(info, 'heading')} />
<Text as="p" field={pick(info, 'lede')} class="aside-card__lede" />

<ol class="aside-steps">
{info.steps.map((step, i) => (
<li>
<span class="aside-steps__no">{i + 1}</span>
<span><Text as="b" field={pick(step, 'title')} /><Text as="span" field={pick(step, 'text')} class="aside-steps__txt" /></span>
</li>
))}
</ol>

<div class="aside-card__social">
<Text as="p" field={pick(info, 'questionsLabel')} />
<a class="aside-card__mail" href={`mailto:${info.email}`}>
<svg fill="none" height="15" stroke="currentColor" stroke-width="1.7" viewBox="0 0 24 24" width="15"><rect height="15" rx="2.5" width="19" x="2.5" y="4.5"></rect><path d="M3 6.5l9 6.5 9-6.5"></path></svg>
<span>{info.email}</span>
</a>
</div>
</aside>
</div>
</div>
</section>
</main>
<!-- لا لافتة انضمام هنا: الصفحة نفسها هي وجهة الزر -->
</BaseLayout>
