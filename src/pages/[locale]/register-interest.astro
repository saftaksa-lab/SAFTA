---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Text from '../../components/content/Text.astro';
import HubSpotForm from '../../components/HubSpotForm.astro';
import { getSingleton } from '../../lib/content/cache';
import { pick } from '../../lib/bilingual';
import { crumbHome, formsUi } from '../../lib/ui';
import { isLocale } from '../../lib/locale';

export function getStaticPaths() {
  return [{ params: { locale: 'en' } }, { params: { locale: 'ar' } }];
}
const { locale } = Astro.params;
if (!isLocale(locale)) return new Response(null, { status: 404 });

const hero = getSingleton('register_hero');
const info = getSingleton('register_info');
---
<BaseLayout
  locale={locale}
  title="Register your interest | SAFTA"
  titleAr="سجّل اهتمامك | التحالف السعودي"
  description="Tell us who you are and which challenge you want to work on. We will follow up with the membership pack."
  joinBanner={false}
>
<main>
<section class="page-hero page-hero--plain">
<div class="wrap">
<p class="crumbs"><Text as="a" field={crumbHome} href={`/${locale}`} /><span>/</span>Register interest</p>
<Text as="h1" field={pick(hero, 'title')} />
<Text as="p" field={pick(hero, 'lede')} class="lede" />
</div>
</section>
<section class="ribbon">
<div class="wrap">
<div class="form-shell">
<HubSpotForm email={info.email} formId="71294bfb-a43d-412f-a937-16a0754172ad" success={formsUi.registerSuccess} />
<aside class="aside-card reveal">
<Text as="h3" field={pick(info, 'heading')} />
<Text as="p" field={pick(info, 'lede')} class="aside-card__lede" />

<ol class="aside-steps">
{info.steps.map((step, i) => (
<li>
<span class="aside-steps__no">{i + 1}</span>
<span><Text as="b" field={pick(step, 'title')} /><Text as="span" field={pick(step, 'text')} class="aside-steps__txt" /></span>
</li>
))}
</ol>

<div class="aside-card__social">
<Text as="p" field={pick(info, 'questionsLabel')} />
<a class="aside-card__mail" href={`mailto:${info.email}`}>
<svg fill="none" height="15" stroke="currentColor" stroke-width="1.7" viewBox="0 0 24 24" width="15"><rect height="15" rx="2.5" width="19" x="2.5" y="4.5"></rect><path d="M3 6.5l9 6.5 9-6.5"></path></svg>
<span>{info.email}</span>
</a>
</div>
</aside>
</div>
</div>
</section>
</main>
<!-- لا لافتة انضمام هنا: الصفحة نفسها هي وجهة الزر -->
</BaseLayout>
