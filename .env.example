# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# The site's public origin, exactly as the browser sees it (https://… in production).
# Session cookies fail to stick if it is wrong, and it also decides which reverse-proxy
# headers Astro trusts, so a wrong value 403s every login. Rebuild after changing it.
BETTER_AUTH_URL=http://127.0.0.1:4321

# SQLite file location (relative to the project root)
DATABASE_PATH=./data/safta.db

# Uploaded images. Never inside public/ — that directory is build input.
UPLOAD_PATH=./data/uploads

# The single admin account, created on first launch by `npm run db:seed` (run by
# `npm run dev` and `npm start`). ADMIN_PASSWORD is only read when the account is
# created: changing it later does NOT change the password.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Administrator
