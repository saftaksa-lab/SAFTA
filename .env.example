# Username for the single admin/member login. Plain text is fine — only the
# password needs to be secret.
ADMIN_USERNAME=changeme

# Output of `npm run hash-password` — format: scrypt$<saltHex>$<hashHex>
# NEVER put a plaintext password here.
ADMIN_PASSWORD_HASH=

# Idle timeout: session expires after this many minutes of inactivity.
SESSION_IDLE_TIMEOUT_MINUTES=30

# Hard cap on session lifetime even with "keep me signed in" checked.
SESSION_ABSOLUTE_TIMEOUT_MINUTES=480
